<!DOCTYPE html>
<html>
<head>
  <%- include('partials/head', { title: title + ' | FhytsBot' }) %>
  <meta property="og:title" content="<%= title %> | FhytsBot" />
  <meta name="twitter:title" content="<%= title %> | FhytsBot" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:url" content="<%= BASE_URL %>" />
  <meta property="og:image" content="<%= BASE_URL %>/assets/images/gateway.png" />
  <meta name="twitter:image" content="<%= BASE_URL %>/assets/images/gateway.png" />
  <meta name="description" content="Sorry, the page you are looking for cannot be found or an error has occurred. Please check the URL or return to the homepage." />
  <meta property="og:description" content="Sorry, the page you are looking for cannot be found or an error has occurred. Please check the URL or return to the homepage." />
  <meta name="twitter:description" content="Sorry, the page you are looking for cannot be found or an error has occurred. Please check the URL or return to the homepage." />
  <meta name="keywords" content="error page, 404 error, page not found, website error, broken link" />
  <meta name="robots" content="index, follow" />
</head>
<body class="flex items-center justify-center text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	<main class="w-full max-w-sm p-4">
		<section class="relative p-6 bg-white dark:bg-slate-800 rounded-md shadow-md shadow-gray-200 dark:shadow-slate-900 flex flex-col justify-center items-center">
			<img class="h-36 w-auto mx-auto" src="/assets/images/error.png" alt="forbidden" />
			<h1 class="text-3xl font-bold mt-6 text-center">
				<%= title %>
			</h1>
			<p class="text-center mt-2"><%- message %></p>
			<div class="flex justify-center items-center mt-4">
				<a class="flex items-center gap-2 font-semibold px-4 py-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all" href="/">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M10.53 5.47a.75.75 0 0 1 0 1.06l-4.72 4.72H20a.75.75 0 0 1 0 1.5H5.81l4.72 4.72a.75.75 0 1 1-1.06 1.06l-6-6a.75.75 0 0 1 0-1.06l6-6a.75.75 0 0 1 1.06 0" clip-rule="evenodd"/></svg>
					Back to Home
				</a>
			</div>
		<section>
	</main>
	
	<script src="/assets/js/dashboard.js"></script>
</body>
</html>
