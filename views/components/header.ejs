	<header class="sticky top-0 z-50 relative px-4 py-3 flex items-center justify-between gap-9 text-black dark:text-white bg-white dark:bg-slate-800">
		<a href="/" class="flex items-center gap-2">
			<img src="/assets/images/logo.png" class="h-6 w-6 object-cover rounded"/>
			<h1 class="text-xl font-bold">
				<%= __('app.FhytsBot') %>
			</h1>
		</a>
		<nav class="hidden md:flex items-center justify-center gap-6">
			<a href="/" class="nav-link relative group font-normal transition hover:text-sky-500 hover:duration-300 ease-in-out">
			  <%= __('header.Home') %>
			  <span class="absolute bottom-0 left-0 h-0.5 bg-sky-500 transition-all duration-300 ease-in-out w-0 group-hover:w-full"></span>
			</a>
			<a href="/#feature" class="nav-link relative group font-normal transition hover:text-sky-500 hover:duration-300 ease-in-out">
			 <%= __('header.Feature') %>
			  <span class="absolute bottom-0 left-0 h-0.5 bg-sky-500 transition-all duration-300 ease-in-out w-0 group-hover:w-full"></span>
			</a>
			<a href="/#pricing" class="nav-link relative group font-normal transition hover:text-sky-500 hover:duration-300 ease-in-out">
			 <%= __('header.Pricing') %>
			  <span class="absolute bottom-0 left-0 h-0.5 bg-sky-500 transition-all duration-300 ease-in-out w-0 group-hover:w-full"></span>
			</a>
			<a href="/#contact" class="nav-link relative group font-normal transition hover:text-sky-500 hover:duration-300 ease-in-out">
			  <%= __('header.Contact') %>
			  <span class="absolute bottom-0 left-0 h-0.5 bg-sky-500 transition-all duration-300 ease-in-out w-0 group-hover:w-full"></span>
			</a>
		</nav>
		<div class="flex items-center gap-4">
			<button id="toggleDark" class="z-10" title="Toggle Dark Mode">
				<svg id="iconSun" class="h-6 w-6 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd">
					<path d="M4.25 19a.75.75 0 0 1 .75-.75h14a.75.75 0 0 1 0 1.5H5a.75.75 0 0 1-.75-.75m3 3a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5H8a.75.75 0 0 1-.75-.75"/>
					<path d="M6.083 15.25a6.75 6.75 0 1 1 11.835 0H22a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1 0-1.5z"/>
					<path d="M12 1.25a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0V2a.75.75 0 0 1 .75-.75M4.399 4.399a.75.75 0 0 1 1.06 0l.393.392a.75.75 0 0 1-1.06 1.061l-.393-.393a.75.75 0 0 1 0-1.06m15.202 0a.75.75 0 0 1 0 1.06l-.393.393a.75.75 0 0 1-1.06-1.06l.393-.393a.75.75 0 0 1 1.06 0M1.25 12a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1-.75-.75m19 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75"/>
				</svg>
				<svg id="iconMoon" class="h-6 w-6 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
					<path d="M2 12C2 6.477 6.477 2 12 2c.463 0 .54.693.143.933a6.5 6.5 0 1 0 8.924 8.924c.24-.396.933-.32.933.143c0 1.138-.19 2.231-.54 3.25H22a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1 0-1.5h.54A10 10 0 0 1 2 12m3 6.25a.75.75 0 0 0 0 1.5h14a.75.75 0 0 0 0-1.5zm3 3a.75.75 0 0 0 0 1.5h8a.75.75 0 0 0 0-1.5zM19.9 2.307a.483.483 0 0 0-.9 0l-.43 1.095a.48.48 0 0 1-.272.274l-1.091.432a.486.486 0 0 0 0 .903l1.091.432a.48.48 0 0 1 .272.273L19 6.81c.162.41.74.41.9 0l.43-1.095a.48.48 0 0 1 .273-.273l1.091-.432a.486.486 0 0 0 0-.903l-1.091-.432a.48.48 0 0 1-.273-.274z"/>
					<path d="M16.033 8.13a.483.483 0 0 0-.9 0l-.157.399a.48.48 0 0 1-.272.273l-.398.158a.486.486 0 0 0 0 .903l.398.157c.125.05.223.148.272.274l.157.399c.161.41.739.41.9 0l.157-.4a.48.48 0 0 1 .272-.273l.398-.157a.486.486 0 0 0 0-.903l-.398-.158a.48.48 0 0 1-.272-.273z"/>
				</svg>
			</button>
			<form action="/lang" method="get" class="inline-block text-2xl">
			  <select name="locale" class="bg-white dark:bg-slate-800 border-none" onchange="this.form.submit()">
				<option class="text-center" value="en" <%= getLocale() === 'en' ? 'selected' : '' %>>
					🇬🇧
				</option>
				<option class="text-center" value="id" <%= getLocale() === 'id' ? 'selected' : '' %>>
					🇮🇩
				</option>
			  </select>
			</form>
			<a href="/login" class="bg-gradient-to-r text-sm from-sky-500 dark:from-sky-600 to-indigo-500 dark:to-indigo-600 flex items-center gap-2 rounded md:rounded-full px-1 md:px-3 py-1 text-white font-semibold hover:shadow-lg hover:scale-105 hover:duration-all transition-all">
				<span class="hidden md:flex"><%= __('header.Sign In') %></span>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><path d="M12 20a8 8 0 1 0 0-16"/><path stroke-linejoin="round" d="M4 12h10m0 0l-3-3m3 3l-3 3"/></g></svg>
			</a>
		</div>
		<div class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-white via-sky-300 to-white dark:from-slate-800 dark:via-sky-800 dark:to-slate-800"></div>
	</header>