<!DOCTYPE html>
<html>
<head>
  <%- include('partials/head', { title: __('forgot.Reset') + ' | ' + __('app.FhytsBot') }) %>
  <meta property="og:title" content="<%= __('forgot.Reset') %> | <%= __('app.FhytsBot') %>" />
  <meta name="twitter:title" content="<%= __('forgot.Reset') %> | <%= __('app.FhytsBot') %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:url" content="<%= BASE_URL %>" />
  <meta property="og:image" content="<%= BASE_URL %>/assets/images/gateway.png" />
  <meta name="twitter:image" content="<%= BASE_URL %>/assets/images/gateway.png" />
  <meta name="description" content="<%= __('forgot.Reset your password quickly') %>" />
  <meta property="og:description" content="<%= __('forgot.Reset your password quickly') %>" />
  <meta name="twitter:description" content="<%= __('forgot.Reset your password quickly') %>" />
  <meta name="keywords" content="forgot password, reset password, password recovery, account recovery, password reset instructions" />
  <meta name="robots" content="index, follow" />
</head>
<body class="flex items-center justify-center text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	<main class="w-full max-w-sm p-4">
		<section class="relative p-6 bg-white dark:bg-slate-800 rounded-md shadow-md shadow-gray-200 dark:shadow-slate-900 flex flex-col gap-4 justify-center items-center">
			<div class="absolute top-2 right-2">
				<button id="toggleDark" class="z-10" title="Toggle Dark Mode">
				  <svg id="iconSun" class="h-6 w-6 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd">
					<path d="M4.25 19a.75.75 0 0 1 .75-.75h14a.75.75 0 0 1 0 1.5H5a.75.75 0 0 1-.75-.75m3 3a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5H8a.75.75 0 0 1-.75-.75"/>
					<path d="M6.083 15.25a6.75 6.75 0 1 1 11.835 0H22a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1 0-1.5z"/>
					<path d="M12 1.25a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0V2a.75.75 0 0 1 .75-.75M4.399 4.399a.75.75 0 0 1 1.06 0l.393.392a.75.75 0 0 1-1.06 1.061l-.393-.393a.75.75 0 0 1 0-1.06m15.202 0a.75.75 0 0 1 0 1.06l-.393.393a.75.75 0 0 1-1.06-1.06l.393-.393a.75.75 0 0 1 1.06 0M1.25 12a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1-.75-.75m19 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75"/>
				  </svg>
				  <svg id="iconMoon" class="h-6 w-6 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
					<path d="M2 12C2 6.477 6.477 2 12 2c.463 0 .54.693.143.933a6.5 6.5 0 1 0 8.924 8.924c.24-.396.933-.32.933.143c0 1.138-.19 2.231-.54 3.25H22a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1 0-1.5h.54A10 10 0 0 1 2 12m3 6.25a.75.75 0 0 0 0 1.5h14a.75.75 0 0 0 0-1.5zm3 3a.75.75 0 0 0 0 1.5h8a.75.75 0 0 0 0-1.5zM19.9 2.307a.483.483 0 0 0-.9 0l-.43 1.095a.48.48 0 0 1-.272.274l-1.091.432a.486.486 0 0 0 0 .903l1.091.432a.48.48 0 0 1 .272.273L19 6.81c.162.41.74.41.9 0l.43-1.095a.48.48 0 0 1 .273-.273l1.091-.432a.486.486 0 0 0 0-.903l-1.091-.432a.48.48 0 0 1-.273-.274z"/>
					<path d="M16.033 8.13a.483.483 0 0 0-.9 0l-.157.399a.48.48 0 0 1-.272.273l-.398.158a.486.486 0 0 0 0 .903l.398.157c.125.05.223.148.272.274l.157.399c.161.41.739.41.9 0l.157-.4a.48.48 0 0 1 .272-.273l.398-.157a.486.486 0 0 0 0-.903l-.398-.158a.48.48 0 0 1-.272-.273z"/>
				  </svg>
				</button>
			</div>
			<a href="/" class="text-black">
				<img class="h-16 w-16 rounded" src="/assets/images/logo.png" alt="logo" />
			</a>
			<div>
				<h1 class="font-bold text-2xl text-center">
					<%= __('forgot.Reset') %>
				</h1>
				<p class="text-center">
					<%= __('forgot.Reset your old password') %>
				</p>
			</div>
			<% if (typeof message !== 'undefined' && message) { %>
			  <div class="px-4 py-1 mb-4 rounded-full text-xs text-center
				<%= messageType === 'success'
				  ? 'text-emerald-500'
				  : 'text-rose-500' %>">
				<%= message %>
			  </div>
			<% } %>

			<form action="/forgot-password" method="POST" class="w-full flex flex-col gap-4">
			  <div class="flex flex-col gap-1">
				<label for="email" class="font-medium"><%= __('forgot.Email') %></label>
				<input 
				  id="email" 
				  type="email" 
				  name="email" 
				  class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" 
				  placeholder="john@gmail.com" 
				  value="<%= typeof email !== 'undefined' ? email : '' %>" 
				  required
				  <%= showOtp ? 'readonly' : '' %>
				/>
			  </div>

			  <% if (showOtp) { %>
				<div class="flex flex-col gap-1">
				  <label for="otp" class="font-medium">><%= __('forgot.Code OTP') %></label>
				  <div id="otpInputs" class="flex justify-between gap-2 max-w-xs">
					<% for(let i=1; i<=6; i++) { %>
					  <input type="text" name="otp<%= i %>" inputmode="numeric" maxlength="1" class="otp-input w-11 text-center bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" required />
					<% } %>
				  </div>
				  <input type="hidden" name="otp" id="otpHidden" />
				</div>

				<div class="mt-4 flex flex-col items-center gap-3 max-w-xs">
				  <button 
					id="resendBtn" 
					type="submit" 
					name="resendOtp" 
					value="true" 
					class="px-4 py-2 rounded-md bg-gray-300 dark:bg-slate-900 text-white cursor-not-allowed" 
					disabled>
					<%= __('forgot.Resend OTP') %> (<span id="countdown"><%= otpTimeout %></span>s)
				  </button>
				  <small id="resendInfo" class="text-sm text-center hidden text-gray-500"><%= __('forgot.You can resend now') %></small>
				</div>

				<div class="flex justify-center">
				  <button class="px-4 py-2 rounded-md bg-emerald-500 dark:bg-emerald-600 text-white hover:bg-emerald-600 dark:hover:bg-emerald-500 hover:duration-300 transition-all">
					<%= __('forgot.Verify OTP') %>
				  </button>
				</div>
			  <% } else { %>
				<div class="flex flex-col justify-center mt-2 gap-4">
				  <% if (recaptcha) { %>
				    <%- recaptcha.render() %>
				  <% } %>
				  <div class="flex justify-center">
					  <button class="flex items-center gap-2 px-4 py-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
						<%= __('forgot.Send OTP') %>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.5" d="m4.497 20.835l16.51-7.363c1.324-.59 1.324-2.354 0-2.944L4.497 3.164c-1.495-.667-3.047.814-2.306 2.202l3.152 5.904c.245.459.245 1 0 1.458l-3.152 5.904c-.74 1.388.81 2.87 2.306 2.202Z"/></svg>
					  </button>
				  </div>
				</div>
			  <% } %>
			</form>
			<span class="text-center text-sm">
				<%= __('forgot.Have you got a new password?') %>
				<a href="/login" class="font-semibold text-sky-500 hover:underline">
					<%= __('forgot.Sign In') %>
				</a>
			</span>
		</section>
	</main>
	
	<%- include('components/error-log') %>
	
	<script src="/assets/js/dashboard.js"></script>
<% if (showOtp) { %>
<script>
  const otpInputs = document.querySelectorAll('.otp-input');
  const otpHidden = document.getElementById('otpHidden');
  const resendBtn = document.getElementById('resendBtn');
  const countdownEl = document.getElementById('countdown');
  const resendInfo = document.getElementById('resendInfo');

  otpInputs.forEach((input, index) => {
    input.addEventListener('input', () => {
      if (input.value.length === 1 && index < otpInputs.length - 1) {
        otpInputs[index + 1].focus();
      }
      otpHidden.value = Array.from(otpInputs).map(i => i.value).join('');
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && input.value.length === 0 && index > 0) {
        otpInputs[index - 1].focus();
      }
    });
  });

  otpHidden.value = Array.from(otpInputs).map(i => i.value).join('');

  let timeLeft = parseInt(countdownEl.textContent, 10);
  let timer = setInterval(() => {
    timeLeft--;
    countdownEl.textContent = timeLeft;

    if (timeLeft <= 0) {
      clearInterval(timer);
      resendBtn.disabled = false;
      resendBtn.classList.remove('bg-gray-300', 'cursor-not-allowed');
      resendBtn.classList.add('bg-sky-500', 'hover:bg-sky-600', 'cursor-pointer');
      resendBtn.textContent = '<%= __('forgot.Resend OTP') %>';
      resendInfo.classList.remove('hidden');
    }
  }, 1000);
</script>
<% } %>
</body>
</html>
