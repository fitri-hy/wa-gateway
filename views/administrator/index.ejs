<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Administrator | ' + __('app.FhytsBot') }) %>
  <meta name="robots" content="noindex, nofollow" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash-admin') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: __('analytic.Administrator') }) %>
		<section class="px-4 pb-4">
			<div class="bg-white dark:bg-slate-800 p-4 md:p-6 border rounded-md border-gray-100 dark:border-slate-800 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<%
				  const now = new Date();
				  const hour = now.getHours();
				  let greeting = __('analytic.Welcome');

				  if (hour >= 4 && hour < 11) {
					greeting = __('analytic.Good Morning') + ' ☀️';
				  } else if (hour >= 11 && hour < 15) {
					greeting = __('analytic.Good Afternoon') + ' 🌤️';
				  } else if (hour >= 15 && hour < 18) {
					greeting = __('analytic.Good Evening') + ' 🌇';
				  } else {
					greeting = __('analytic.Good Night') + ' 🌙';
				  }
				%>
				<div class="mb-6 flex flex-col">
				  <span class="font-bold text-2xl md:text-3xl text-black dark:text-white text-center md:text-left"><%= greeting %>, <strong class="text-sky-500"><%= user_name %></strong>.</span>
				  <span class="text-lg text-center md:text-left"><%= __('analytic.We hope you have a productive day') %></span>
				</div>
				
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
					<% 
					  const colors = [
						'bg-emerald-500',
						'bg-blue-500',
						'bg-red-500',
						'bg-yellow-500',
						'bg-pink-500',
						'bg-purple-500',
						'bg-indigo-500',
						'bg-teal-500',
					  ]; 
					%>
					<% counts.forEach((item, index) => { %>
					  <div class="flex flex-col items-center justify-center p-4 rounded-md <%= colors[index % colors.length] %> dark:<%= colors[index % colors.length].replace('500', '600') %> text-white">
						<h2 class="text-xl md:text-3xl font-extrabold">
							<%= item.count %>
						</h2>
						<span class="text-cemter font-semibold">
							<%= __('analytic.' + item.table) %>
						</span>
					  </div>
					<% }) %>
				</div>
				
			</div>
		<section>
	</main>
  
	<script src="/assets/js/dashboard.js"></script>
</body>
</html>
