<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Users Administrator | FhytsBot' }) %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash-admin') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: 'Users' }) %>
		<section class="px-4 pb-4">
			<div class="bg-white dark:bg-slate-800 p-4 md:p-6 border rounded-md border-gray-100 dark:border-slate-800 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<div class="mb-4 flex items-center justify-between gap-4">
					<form class="flex items-center gap-2" method="GET">
						<input type="text" name="search" id="search" value="<%= search %>" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="Search...">
						<button type="submit" title="Search" class="flex items-center gap-2 font-semibold p-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
							</svg>
						</button>
					</form>
				</div>
				<div class="prose prose-lg dark:prose-invert max-w-none">
					<div class="overflow-auto w-full">
						<table>
							<thead>
								<tr>
									<th>Name</th>
									<th>Email</th>
									<th>Role</th>
									<th>Status</th>
									<th class="text-center">Action</th>
								</tr>
							</thead>
							<tbody>
								<% if (!users || users.length === 0) { %>
									<tr>
									<td colspan="5" class="text-center">No users found.</td>
									</tr>
								<% } else { %>
								<% users.forEach(user => { %>
									<tr>
										<td class="whitespace-nowrap text-black dark:text-white">
											<%= user.name %>
											<% if (user.id === user_id) { %>
											  <span class="text-xs px-1 py-[2px] rounded bg-sky-500 dark:bg-sky-600 text-white">You</span>
											<% } %>
										</td>
										<td><%= user.email %></td>
										<td>
											<%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
										</td>
										<td class="<%= user.status === 'active' ? 'text-green-500 font-semibold' : 'text-rose-500 font-semibold' %>">
											<%= user.status.charAt(0).toUpperCase() + user.status.slice(1) %>
										</td>
										<td>
											<div class="flex items-center justify-center gap-1">
												<button 
													data-id="<%= user.id %>" 
													data-name="<%= user.name %>"
													data-email="<%= user.email %>"
													data-role="<%= user.role %>"
													data-status="<%= user.status %>"
													class="open-edit-modal text-amber-500 p-1 hover:bg-gray-100 dark:hover:bg-slate-900 rounded-full">
													<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="m11.4 18.161l7.396-7.396a10.3 10.3 0 0 1-3.326-2.234a10.3 10.3 0 0 1-2.235-3.327L5.839 12.6c-.577.577-.866.866-1.114 1.184a6.6 6.6 0 0 0-.749 1.211c-.173.364-.302.752-.56 1.526l-1.362 4.083a1.06 1.06 0 0 0 1.342 1.342l4.083-1.362c.775-.258 1.162-.387 1.526-.56q.647-.308 1.211-.749c.318-.248.607-.537 1.184-1.114m9.448-9.448a3.932 3.932 0 0 0-5.561-5.561l-.887.887l.038.111a8.75 8.75 0 0 0 2.092 3.32a8.75 8.75 0 0 0 3.431 2.13z"/></svg>
												</button>
												<form action="/administrator/users/delete/<%= user.id %>" method="POST" title="Update">
												  <button type="submit" class="text-rose-500 p-1 hover:bg-gray-100 dark:hover:bg-slate-900 rounded-full" title="Delete">
													<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M2.75 6.167c0-.46.345-.834.771-.834h2.665c.529-.015.996-.378 1.176-.916l.03-.095l.115-.372c.07-.228.131-.427.217-.605c.338-.702.964-1.189 1.687-1.314c.184-.031.377-.031.6-.031h3.478c.223 0 .417 0 .6.031c.723.125 1.35.612 1.687 1.314c.086.178.147.377.217.605l.115.372l.03.095c.18.538.74.902 1.27.916h2.57c.427 0 .772.373.772.834S20.405 7 19.979 7H3.52c-.426 0-.771-.373-.771-.833M11.607 22h.787c2.707 0 4.06 0 4.941-.863c.88-.864.97-2.28 1.15-5.111l.26-4.081c.098-1.537.147-2.305-.295-2.792s-1.187-.487-2.679-.487H8.23c-1.491 0-2.237 0-2.679.487s-.392 1.255-.295 2.792l.26 4.08c.18 2.833.27 4.248 1.15 5.112S8.9 22 11.607 22"/></svg>
												  </button>
												</form>
											</div>
										</td>
									</tr>
								<% }) %>
								<% } %>
							</tbody>
						</table>
					</div>
				</div>
				<div class="flex items-center gap-2 justify-center mt-6">
				  <% if (totalPages > 1) { %>
					<% if (currentPage > 1) { %>
					  <a href="?search=<%= search %>&page=1" class="h-7 w-7 flex items-center justify-center p-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white rounded" title="First">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m13 19l-6-7l6-7"/><path d="m17 19l-6-7l6-7"/></g></svg>
					  </a>
					<% } %>

					<% for (let i = 1; i <= totalPages; i++) { %>
					  <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
						<a href="?search=<%= search %>&page=<%= i %>" class="h-7 w-7 flex items-center justify-center p-1 rounded 
						  <%= i === currentPage ? 'bg-sky-500 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white' %>">
						  <%= i %>
						</a>
					  <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
						<span class="h-7 w-4 flex items-center justify-center p-1">...</span>
					  <% } %>
					<% } %>

					<% if (currentPage < totalPages) { %>
					  <a href="?search=<%= search %>&page=<%= totalPages %>" class="h-7 w-7 flex items-center justify-center p-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white rounded">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m11 19l6-7l-6-7"/><path d="m7 19l6-7l-6-7"/></g></svg>
					  </a>
					<% } %>
				  <% } %>
				</div>
			</div>
		<section>
	</main>
	
	<div id="editModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 hidden">
	  <div class="bg-white dark:bg-slate-800 rounded-md w-full max-w-md shadow-lg p-4 md:p-6 relative">
		<h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-white">Edit User</h2>
		<form id="editUserForm" method="POST" action="/administrator/users/update">
		  <input type="hidden" name="id" id="edit-user-id" required>
		  <div class="mb-4">
			<label for="edit-name" class="block text-sm font-medium mb-1">Name</label>
			<input type="text" id="edit-name" name="name" maxlength="25" pattern="^[a-zA-Z\s]+$" required class="w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
		  </div>

		  <div class="mb-4">
			<label for="edit-email" class="block text-sm font-medium mb-1">Email</label>
			<input id="edit-email" readonly required class="w-full bg-gray-200 dark:bg-slate-950 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
		  </div>

		  <div class="mb-4">
			<label for="edit-role" class="block text-sm font-medium mb-1">Role</label>
			<select id="edit-role" name="role" required class="w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
			  <option value="superadmin">Superadmin</option>
			  <option value="admin">Admin</option>
			  <option value="user">User</option>
			</select>
		  </div>

		  <div class="mb-4">
			<label for="edit-status" class="block text-sm font-medium mb-1">Status</label>
			<select id="edit-status" name="status" required class="w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
			  <option value="active">Active</option>
			  <option value="inactive">Inactive</option>
			  <option value="suspended">Suspended</option>
			</select>
		  </div>

		  <div class="flex justify-end gap-2">
			<button type="button" id="closeEditModal" class="flex items-center gap-2 font-semibold px-2 py-2 md:px-4 rounded-md bg-rose-500 dark:bg-rose-600 text-white hover:bg-rose-600 dark:hover:bg-rose-500 hover:duration-300 transition-all">
				Cancel
			</button>
			<button type="submit" class="flex items-center gap-2 font-semibold px-2 py-2 md:px-4 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
				Save
			</button>
		  </div>
		</form>
	  </div>
	</div>

	<%- include('../components/error-log') %>
	
	<script src="/assets/js/dashboard.js"></script>
	<script>
	  document.querySelectorAll('.open-edit-modal').forEach(button => {
		button.addEventListener('click', function () {
		  const id = this.dataset.id;
		  const name = this.dataset.name;
		  const email = this.dataset.email;
		  const role = this.dataset.role;
		  const status = this.dataset.status;
		  document.getElementById('edit-user-id').value = id;
		  document.getElementById('edit-name').value = name;
		  document.getElementById('edit-email').value = email;
		  document.getElementById('edit-role').value = role;
		  document.getElementById('edit-status').value = status;
		  document.getElementById('editModal').classList.remove('hidden');
		});
	  });
	  document.getElementById('closeEditModal').addEventListener('click', () => {
		document.getElementById('editModal').classList.add('hidden');
	  });
	</script>
</body>
</html>
