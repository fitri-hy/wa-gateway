<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Add Plugins Administrator | FhytsBot' }) %>
  <meta name="robots" content="noindex, nofollow" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.9/codemirror.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.9/theme/dracula.min.css" />
  <style>
    .CodeMirror pre {
      padding: 0 !important;
    }
  </style>
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash-admin') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: (editing ? 'Edit Plugins' : 'Add Plugins') + ' Administrator | FhytsBot' }) %>
		<section class="px-4 pb-4">
			<div class="bg-white dark:bg-slate-800 p-4 md:p-6 border rounded-md border-gray-100 dark:border-slate-800 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<form action="/administrator/plugins/<%= editing ? 'edit' : 'add' %>" method="POST" class="flex flex-col flex-grow">
					<div>
						<label for="title" class="block text-sm font-medium mb-1">Plugin File Name (.js)</label>
						<div class="flex items-center gap-2">
							<input type="text" id="title" name="title" value="<%= title %>" placeholder="Eg: _example.js" required <%= editing ? 'readonly' : '' %> class="<%= editing ? 'bg-gray-200 dark:bg-slate-950' : 'bg-gray-50 dark:bg-slate-900' %> w-full max-w-xs px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none"/>
							<button type="submit" class="flex items-center justify-center gap-2 rounded-md font-semibold px-4 py-2 bg-sky-500 dark:bg-sky-600 hover:bg-sky-600 dark:hover:bg-sky-500 text-white text-center hover:duration-300 transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.464 20.536C4.93 22 7.286 22 12 22s7.071 0 8.535-1.465C22 19.072 22 16.714 22 12c0-.341 0-.512-.015-.686a4.04 4.04 0 0 0-.921-2.224a8 8 0 0 0-.483-.504l-5.167-5.167a9 9 0 0 0-.504-.483a4.04 4.04 0 0 0-2.224-.92C12.512 2 12.342 2 12 2C7.286 2 4.929 2 3.464 3.464C2 4.93 2 7.286 2 12s0 7.071 1.464 8.535Z"/><path d="M17 22v-1c0-1.886 0-2.828-.586-3.414S14.886 17 13 17h-2c-1.886 0-2.828 0-3.414.586S7 19.114 7 21v1"/><path stroke-linecap="round" d="M7 8h6"/></g></svg>
								Save
							</button>
						</div>
					</div>

					<div class="flex flex-col flex-grow mt-4">
						<label for="code" class="block text-sm font-medium mb-1">Plugin Code</label>
						<textarea id="code" name="code" required class="hidden"><%= code %></textarea>
						<div id="codemirror-editor" class="rounded resize-y overflow-auto min-h-[150px] max-h-[80vh] w-full rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none"></div>
					</div>
				</form>
			</div>
		</section>
	</main>

	<%- include('../components/error-log') %>
	
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.9/codemirror.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.9/mode/javascript/javascript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.9/addon/edit/closebrackets.min.js"></script>
  <script>
	  const textarea = document.getElementById('code');
	  const editorDiv = document.getElementById('codemirror-editor');

	  const editor = CodeMirror(editorDiv, {
		value: textarea.value,
		mode: 'javascript',
		theme: 'dracula',
		lineNumbers: true,
		autoCloseBrackets: true,
		tabSize: 2,
		indentUnit: 2,
		indentWithTabs: false,
	  });

	  editor.setSize('100%', '100%');

	  const form = textarea.closest('form');
	  form.addEventListener('submit', () => {
		textarea.value = editor.getValue();
	  });

	  window.addEventListener('resize', () => {
		editor.refresh();
	  });

	  if (window.ResizeObserver) {
		const resizeObserver = new ResizeObserver(() => {
		  editor.refresh();
		});
		resizeObserver.observe(editorDiv);
	  }
	</script>
	<script src="/assets/js/dashboard.js"></script>
</body>
</html>
