<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Whatsapp Gateway | FhytsBot' }) %>
</head>
<body class="min-h-screen bg-gradient-to-br from-white to-sky-50/60 dark:from-neutral-900 dark:to-slate-900 text-gray-800 dark:text-gray-100">
	<div class="-z-10 fixed top-0 h-[100vh] inset-0 bg-[linear-gradient(to_right,#94a3b82e_1px,transparent_1px),linear-gradient(to_bottom,#94a3b82e_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4755692e_1px,transparent_1px),linear-gradient(to_bottom,#4755692e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
	<%- include('components/header') %>
	<section class="container mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 p-4 md:p-6 items-center">
		<div class="flex md:hidden item-center justify-center">
			<img src="/assets/images/gateway.png" alt="whastapp-gateway" class="w-full h-full object-contain max-w-md m-auto" />
		</div>
		<div class="flex flex-col gap-4 md:gap-4">
			<h1 class="text-3xl md:text-4xl xl:text-5xl font-bold text-black dark:text-white tracking-tight md:max-w-xl text-center md:text-left">
				<span class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-500">WhatsApp Gateway</span> 
				for Business Automation
			<h1>
			<p class="md:max-w-xl text-center md:text-left">
				Build 24/7 customer communication and send notifications, auto-replies, and mass messages in just a few clicks without any hassle.
			</p>
			<div class="mt-6 md:mt-9 flex items-center gap-4">
				<a href="/pricing" class="bg-gradient-to-r from-sky-500 dark:from-sky-600 to-indigo-500 dark:to-indigo-600 flex items-center gap-2 rounded-full px-4 py-2 text-white font-semibold hover:shadow-lg hover:scale-105 hover:duration-all hover:transition-all">
					Connect
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
				</a>
				<a href="#" class="relative group text-black dark:text-white hover:text-sky-500 dark:hover:text-sky-500 font-semibold bg-white dark:bg-slate-900 flex items-center gap-2 pb-1 hover:scale-105 hover:duration-all hover:transition-all">
					Learn
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
				    <span class="absolute bottom-0 left-0 h-0.5 bg-sky-500 transition-all duration-300 ease-in-out w-0 group-hover:w-full"></span>
				</a>
			</div>
		</div>
		<div class="hidden md:flex item-center justify-center">
			<img src="/assets/images/gateway.png" alt="whastapp-gateway" class="w-full h-full object-contain max-w-md m-auto" />
		</div>
	</section>
	<section id="feature" class="max-w-6xl mx-auto p-4 md:p-6 items-center mt-20">
		<h2 class="text-2xl md:text-3xl text-center font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-500">
			Feature
		</h2>
		<p class="max-w-lg mx-auto text-center mt-2">
			FhytsBot comes with a superior feature to manage WhatsApp messages automatically.
		</p>
		<div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mt-9">
			<div class="flex flex-col bg-white dark:bg-slate-800 shadow-md shadow-gray-200 dark:shadow-slate-700/50  p-4 rounded-md border-t-4 border-sky-500">
				<img src="/assets/images/icon/send-message.png" alt="send-message" class="h-16 w-16 object-cover mb-4" />
				<h3 class="text-xl font-semibold">
					Send Message
				</h3>
				<p>
					Send automated messages to contacts individually.
				</p>
			</div>
			<div class="flex flex-col bg-white dark:bg-slate-800 shadow-md shadow-gray-200 dark:shadow-slate-700/50  p-4 rounded-md border-t-4 border-sky-500">
				<img src="/assets/images/icon/broadcast.png" alt="broadcast" class="h-16 w-16 object-cover mb-4" />
				<h3 class="text-xl font-semibold">
					Broadcast
				</h3>
				<p>
					Easily send messages to multiple contacts at once.
				</p>
			</div>
			<div class="flex flex-col bg-white dark:bg-slate-800 shadow-md shadow-gray-200 dark:shadow-slate-700/50  p-4 rounded-md border-t-4 border-sky-500">
				<img src="/assets/images/icon/auto-reply.png" alt="auto-reply" class="h-16 w-16 object-cover mb-4" />
				<h3 class="text-xl font-semibold">
					Auto Reply
				</h3>
				<p>
					Reply to messages automatically according to specified keywords.
				</p>
			</div>
			<div class="flex flex-col bg-white dark:bg-slate-800 shadow-md shadow-gray-200 dark:shadow-slate-700/50  p-4 rounded-md border-t-4 border-sky-500">
				<img src="/assets/images/icon/plugin-ad-ons.png" alt="plugin-ad-ons" class="h-16 w-16 object-cover mb-4" />
				<h3 class="text-xl font-semibold">
					Plugin Ad-Ons
				</h3>
				<p>
					Additional integrations to extend the bot's functionality.
				</p>
			</div>
			<div class="flex flex-col bg-white dark:bg-slate-800 shadow-md shadow-gray-200 dark:shadow-slate-700/50  p-4 rounded-md border-t-4 border-sky-500">
				<img src="/assets/images/icon/multi-account.png" alt="multi-account" class="h-16 w-16 object-cover mb-4" />
				<h3 class="text-xl font-semibold">
					Multi Account
				</h3>
				<p>
					Manage multiple WhatsApp accounts in one platform.
				</p>
			</div>
			<div class="flex flex-col bg-white dark:bg-slate-800 shadow-md shadow-gray-200 dark:shadow-slate-700/50  p-4 rounded-md border-t-4 border-sky-500">
				<img src="/assets/images/icon/rest-api.png" alt="rest-api" class="h-16 w-16 object-cover mb-4" />
				<h3 class="text-xl font-semibold">
					Rest API
				</h3>
				<p>
					Access and control bots through flexible API integration.
				</p>
			</div>
		</div>
	</section>
	
	<script src="/assets/js/app.js"></script>
</body>
</html>
