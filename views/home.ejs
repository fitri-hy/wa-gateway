<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Whatsapp Gateway | FhytsBot' }) %>
</head>
<body class="min-h-screen flex flex-col justify-center items-center bg-gradient-to-br from-white to-sky-50/60 dark:from-neutral-900 dark:to-slate-900 text-gray-800 dark:text-gray-100">
	<div class="-z-10 fixed top-0 h-[100vh] inset-0 bg-[linear-gradient(to_right,#94a3b82e_1px,transparent_1px),linear-gradient(to_bottom,#94a3b82e_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4755692e_1px,transparent_1px),linear-gradient(to_bottom,#4755692e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
	<div class="absolute -z-10 top-1/4 left-1/4 w-32 h-32 rounded-full bg-purple-500/20 blur-xl floating"></div>
	<div class="absolute -z-10 top-1/3 right-1/4 w-40 h-40 rounded-full bg-blue-500/20 blur-xl floating-2"></div>
	<div class="absolute -z-10 bottom-1/4 right-1/3 w-28 h-28 rounded-full bg-pink-500/20 blur-xl floating-3"></div>
	
	<section class="h-full w-full">
		<div class="relative p-4">
			<div>
				<img src="/assets/images/gateway.png" alt="whastapp-gateway" class="h-full w-auto mx-auto" />
			</div>
			<div class="-mt-16 -mt-36 w-full max-w-3xl w-auto mx-auto bg-white/70 backdrop-blur-sm shadow-lg px-9 py-12 rounded-xl">
				<h1 class="text-5xl md:text-6xl font-bold text-black glow-text text-center">
				  <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500">FhytsBot</span>
				</h1>
				<h2 class="text-lg md:text-2xl font-semibold text-center  mt-2 md:mt-4">
					WhatsApp Gateway for Business Automation
				</h2>
				<p class="text-sm md:text-lg text-center mt-2 md:mt-4">
					Build 24/7 customer communication and send notifications, auto-replies, and mass messages in just a few clicks without any hassle.
				</p>
				<div class="flex items-center justify-center gap-4 mt-6">
					<a href="/login" class="bg-gradient-to-r text-lg from-sky-500 dark:from-sky-600 to-indigo-500 dark:to-indigo-600 flex items-center gap-2 rounded-full px-4 py-3 text-white font-semibold hover:shadow-lg hover:scale-105 hover:duration-all transition-all">
						Create Now
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
					</a>
				</div>
			</div>
		</div>
	</section>
	<script src="/assets/js/app.js"></script>
</body>
</html>
