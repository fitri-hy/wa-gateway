<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Whatsapp Gateway | FhytsBot' }) %>
</head>
<body class="min-h-screen bg-gradient-to-br from-white to-sky-50/60 dark:from-neutral-900 dark:to-slate-900 text-gray-800 dark:text-gray-100">
	<div class="-z-10 fixed top-0 h-[100vh] inset-0 bg-[linear-gradient(to_right,#94a3b82e_1px,transparent_1px),linear-gradient(to_bottom,#94a3b82e_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4755692e_1px,transparent_1px),linear-gradient(to_bottom,#4755692e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
	<%- include('components/header') %>
	<section class="container mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 p-4 md:p-6 items-center">
		<div class="flex md:hidden item-center justify-center">
			<img src="/assets/images/gateway.png" alt="whastapp-gateway" class="w-full h-full object-contain max-w-md m-auto" />
		</div>
		<div class="flex flex-col gap-4 md:gap-6">
			<h1 class="text-3xl md:text-4xl font-bold text-black dark:text-white tracking-tight md:max-w-xl text-center md:text-left">
				WhatsApp 
				<span class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-500">Gateway</span> 
				untuk <span class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-500">Otomatisasi</span> 
				Bisnis
			<h1>
			<p class="md:max-w-xl text-center md:text-left">
				Bangun komunikasi pelanggan 24/7 dan kirim notifikasi, balasan otomatis, dan pesan massal hanya dalam beberapa klik tanpa ribet.
			</p>
			<div class="mt-4 md:mt-6 flex items-center gap-4">
				<a href="/pricing" class="bg-gradient-to-r from-sky-500 dark:from-sky-600 to-indigo-500 dark:to-indigo-600 flex items-center gap-2 rounded-full px-4 py-2 text-white font-semibold hover:shadow-lg hover:scale-105 hover:duration-all hover:transition-all">
					Hubungkan
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
				</a>
				<a href="#" class="text-sky-500 hover:text-sky-600 font-semibold bg-white dark:bg-slate-900 flex items-center gap-2 border-b-2 border-sky-500 hover:border-sky-600 pb-1 hover:scale-105 hover:duration-all hover:transition-all">
					Pelajari
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6m0 0H9m9 0v9"/></svg>
				</a>
			</div>
		</div>
		<div class="hidden md:flex item-center justify-center">
			<img src="/assets/images/gateway.png" alt="whastapp-gateway" class="w-full h-full object-contain max-w-md m-auto" />
		</div>
	</section>
	<script src="/assets/js/app.js"></script>
</body>
</html>
