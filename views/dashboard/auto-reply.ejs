	<%- include('../components/error-log') %>
  
  <script src="/assets/js/dashboard.js"></script>
  <script>
    const btnOpenModal = document.getElementById('btnOpenModal');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const modal = document.getElementById('modalAddAutoReply');

    btnOpenModal.addEventListener('click', () => {
      modal.classList.remove('hidden');
    });

    btnCancelModal.addEventListener('click', () => {
      modal.classList.add('hidden');
    });
  </script>
	<script>
		const uploadModal = document.querySelector('.upload-modal');
		  const closeUploadModalBtn = uploadModal.querySelector('.close-upload-modal');
		  const uploadList = uploadModal.querySelector('.upload-list');
		  const uploadSearchInput = uploadModal.querySelector('.upload-search-input');
		  let currentImageUrlInput = null;

		  document.querySelectorAll('.open-upload-modal-btn').forEach(button => {
			button.addEventListener('click', (e) => {
			  const parent = e.target.closest('div');
			  currentImageUrlInput = parent.querySelector('.uploads-url-input');
			  uploadModal.classList.remove('hidden');
			  uploadSearchInput.value = '';
			  filterUploads('');
			  uploadSearchInput.focus();
			});
		  });

		  closeUploadModalBtn.addEventListener('click', () => {
			uploadModal.classList.add('hidden');
		  });

		  uploadModal.addEventListener('click', (e) => {
			if (e.target === uploadModal) {
			  uploadModal.classList.add('hidden');
			}
		  });

		uploadList.addEventListener('click', (e) => {
		  const btn = e.target.closest('button.upload-item');
		  if (!btn) return;
		  if (currentImageUrlInput) {
			currentImageUrlInput.value = btn.getAttribute('data-url');
		  }
		  uploadModal.classList.add('hidden');
		});

		uploadSearchInput.addEventListener('input', () => {
		  const query = uploadSearchInput.value.toLowerCase();
		  filterUploads(query);
		});

		function filterUploads(query) {
		  const uploadButtons = uploadList.querySelectorAll('button.upload-item');
		  uploadButtons.forEach(btn => {
		    const name = btn.getAttribute('data-name');
		    if (name.includes(query)) {
			  btn.classList.remove('hidden');
		    } else {
		      btn.classList.add('hidden');
		    }
		  });
		}

		document.querySelector('#contact-search-form').addEventListener('submit', e => e.preventDefault());
		document.querySelector('.upload-search-form').addEventListener('submit', e => e.preventDefault());
	</script>
	<script>
	  document.addEventListener('DOMContentLoaded', function () {
		const modal = document.getElementById('detailModal');
		const closeBtn = document.getElementById('closeDetailModal');
		const filePreview = document.getElementById('filePreview');

		function getFileExtension(filename) {
		  return filename.split('.').pop().toLowerCase();
		}

		function isImage(ext) {
		  return ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'].includes(ext);
		}

		function isAudio(ext) {
		  return ['mp3', 'wav', 'ogg', 'm4a'].includes(ext);
		}

		function isVideo(ext) {
		  return ['mp4', 'webm', 'ogg'].includes(ext);
		}

		function showFilePreview(fileUrl) {
		  if (!fileUrl) {
			filePreview.innerHTML = '';
			return;
		  }
		  const ext = getFileExtension(fileUrl);
		  filePreview.innerHTML = '';

		  if (isImage(ext)) {
			filePreview.innerHTML = `<img src="${fileUrl}" alt="File Preview" class="aspect-[16/9] h-full w-full object-cover rounded" />`;
		  } else if (isAudio(ext)) {
			filePreview.innerHTML = `<audio controls src="${fileUrl}" class="aspect-[16/9] h-full w-full rounded"></audio>`;
		  } else if (isVideo(ext)) {
			filePreview.innerHTML = `<video controls src="${fileUrl}" class="aspect-[16/9] h-full w-fullrounded"></video>`;
		  } else if (ext === 'pdf') {
			filePreview.innerHTML = `<iframe src="${fileUrl}" class="aspect-[16/9] h-full w-full"></iframe>`;
		  } else {
			filePreview.innerHTML = '';
		  }
		}

		document.querySelectorAll('.open-detail-modal').forEach(btn => {
		  btn.addEventListener('click', function () {
			document.getElementById('detailSession').value = this.dataset.session;
			document.getElementById('detailTitle').value = this.dataset.title;
			document.getElementById('detailPrefix').value = this.dataset.prefix;
			document.getElementById('detailIncludes').value = this.dataset.includes;
			document.getElementById('detailCategory').value = this.dataset.category;
			document.getElementById('detailType').value = this.dataset.type;
			document.getElementById('detailResponse').value = this.dataset.response;
			document.getElementById('detailFile').value = this.dataset.file;
			document.getElementById('detailCreatedAt').value = this.dataset.created_at;

			showFilePreview(this.dataset.file);

			modal.classList.remove('hidden');
			modal.classList.add('flex');
		  });
		});

		closeBtn.addEventListener('click', function () {
		  modal.classList.remove('flex');
		  modal.classList.add('hidden');
		  filePreview.innerHTML = '';
		});

		modal.addEventListener('click', function (e) {
		  if (e.target === modal) {
			modal.classList.remove('flex');
			modal.classList.add('hidden');
			filePreview.innerHTML = '';
		  }
		});
	  });
	</script>
	<script>
	  document.addEventListener('DOMContentLoaded', function () {
		const typeSelect = document.getElementById('type');
		const fileNameContainer = document.getElementById('fileNameContainer');
		const fileUrlContainer = document.getElementById('fileUrlContainer');
		const locationFields = document.getElementById('locationFields');
		const responseTextContainer = document.getElementById('responseTextContainer');

		function toggleFields() {
		  const type = typeSelect.value.toLowerCase();

		  const showFile = ['image', 'video', 'audio', 'document', 'sticker'].includes(type);
		  const showLocation = type === 'location';
		  const showResponseText = !['audio', 'sticker'].includes(type);
		  const showFileName = type === 'document';

		  fileUrlContainer.classList.toggle('hidden', !showFile);
		  locationFields.classList.toggle('hidden', !showLocation);
		  responseTextContainer.classList.toggle('hidden', !showResponseText);
		  fileNameContainer.classList.toggle('hidden', !showFileName);
		}

		typeSelect.addEventListener('change', toggleFields);
		toggleFields();
	  });
	</script>
</body>
</html>
