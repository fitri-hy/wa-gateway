					<div class="flex flex-col">
						<label>Prefix:</label>
						<input id="detailPrefix" readonly class="w-full bg-gray-50 dark:bg-slate-900 p-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
					</div>
