<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Dashboard | FhytsBot' }) %>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: 'Dashboard' }) %>
		<section class="px-4 pb-4">
			<div class="bg-white dark:bg-slate-800 p-4 md:p-6 border rounded-md border-gray-100 dark:border-slate-800 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<%
				  const now = new Date();
				  const hour = now.getHours();
				  let greeting = 'Welcome';

				  if (hour >= 4 && hour < 11) {
					greeting = 'Good Morning ☀️';
				  } else if (hour >= 11 && hour < 15) {
					greeting = 'Good Afternoon 🌤️';
				  } else if (hour >= 15 && hour < 18) {
					greeting = 'Good Evening 🌇';
				  } else {
					greeting = 'Good Night 🌙';
				  }
				%>
				<div class="mb-6 flex flex-col">
				  <span class="font-bold text-2xl md:text-3xl text-black dark:text-white text-center md:text-left"><%= greeting %>, <strong class="text-sky-500"><%= user_name %></strong>.</span>
				  <span class="text-lg text-center md:text-left">We hope you have a productive day.</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div class="md:col-span-2">
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
							<div class="relative flex flex-col items-center justify-center p-4 rounded-md bg-emerald-500 dark:bg-emerald-600 text-white">
								<svg class="absolute top-2 left-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12.052 2h-.104c-1.68 0-3.01 0-4.052.142c-1.072.147-1.94.456-2.624 1.152s-.988 1.58-1.132 2.67C4 7.024 4 8.378 4 10.087v3.826c0 1.71 0 3.064.14 4.123c.144 1.09.448 1.974 1.132 2.67s1.552 1.005 2.624 1.152C8.937 22 10.268 22 11.948 22h.104c1.68 0 3.01 0 4.052-.142c1.072-.147 1.94-.456 2.624-1.152s.988-1.58 1.132-2.67c.14-1.06.14-2.414.14-4.123v-3.826c0-1.71 0-3.064-.14-4.123c-.144-1.09-.448-1.974-1.132-2.67s-1.552-1.005-2.624-1.152C15.063 2 13.732 2 12.052 2m-3.48 16.512a.69.69 0 0 1 .685-.698h5.486c.379 0 .686.312.686.698a.69.69 0 0 1-.686.697H9.257a.69.69 0 0 1-.686-.697" clip-rule="evenodd"/></svg>
								<h2 class="text-xl md:text-3xl font-extrabold mt-4">
									<%= totalSessions || 0 %>
								</h2>
								<span class="text-cemter font-semibold">Devices</span>
							</div>
							<div class="relative flex flex-col items-center justify-center p-4 rounded-md bg-indigo-500 dark:bg-indigo-600 text-white">
								<svg class="absolute top-2 left-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12c0 1.6.376 3.112 1.043 4.453c.178.356.237.763.134 1.148l-.595 2.226a1.3 1.3 0 0 0 1.591 1.592l2.226-.596a1.63 1.63 0 0 1 1.149.133A9.96 9.96 0 0 0 12 22m-4-8.75a.75.75 0 0 0 0 1.5h5.5a.75.75 0 0 0 0-1.5zm-.75-2.75A.75.75 0 0 1 8 9.75h8a.75.75 0 0 1 0 1.5H8a.75.75 0 0 1-.75-.75" clip-rule="evenodd"/></svg>
								<h2 class="text-xl md:text-3xl font-extrabold mt-4">
									<%= totalMessages || 0 %>
								</h2>
								<span class="text-cemter font-semibold">Sending</span>
							</div>
							<div class="relative flex flex-col items-center justify-center p-4 rounded-md bg-amber-500 dark:bg-amber-600 text-white">
								<svg class="absolute top-2 left-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12c0 1.6.376 3.112 1.043 4.453c.178.356.237.763.134 1.148l-.595 2.226a1.3 1.3 0 0 0 1.591 1.592l2.226-.596a1.63 1.63 0 0 1 1.149.133A9.96 9.96 0 0 0 12 22m-4-8.75a.75.75 0 0 0 0 1.5h5.5a.75.75 0 0 0 0-1.5zm-.75-2.75A.75.75 0 0 1 8 9.75h8a.75.75 0 0 1 0 1.5H8a.75.75 0 0 1-.75-.75" clip-rule="evenodd"/></svg>
								<h2 class="text-xl md:text-3xl font-extrabold mt-4">
									<%= totalBroadcasts || 0 %>
								</h2>
								<span class="text-cemter font-semibold">Broadcast</span>
							</div>
							<div class="relative flex flex-col items-center justify-center p-4 rounded-md bg-pink-500 dark:bg-pink-600 text-white">
								<svg class="absolute top-2 left-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M8.75 2.013V22H15c2.828 0 4.243 0 5.121-.879C21 20.243 21 18.828 21 16V8c0-2.828 0-4.243-.879-5.121C19.243 2 17.828 2 15 2H9zm2 4.487a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75m0 3.5a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75M3 7.25c.008-2.336.081-3.574.879-4.371c.675-.675 1.666-.832 3.371-.868v19.978c-1.705-.036-2.696-.193-3.371-.868c-.798-.797-.871-2.035-.878-4.371H4a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5zm0 0H2a.75.75 0 0 0 0 1.5h1zm0 5.5H2a.75.75 0 0 1 0-1.5h1zm0 2.5H2a.75.75 0 0 0 0 1.5h1z" clip-rule="evenodd"/></svg>
								<h2 class="text-xl md:text-3xl font-extrabold mt-4">
									<%= totalContacts || 0 %>
								</h2>
								<span class="text-cemter font-semibold">Contact</span>
							</div>
						</div>
						<h1 class="mt-8 text-2xl font-bold leading-tight text-black dark:text-white">
							Create Connections
						</h1>
						<form method="POST" action="/dashboard" class="flex gap-2 items-center mt-4">
							<input type="phone" pattern="^\d{8,15}$" minlength="8" maxlength="15" name="phone" title="The phone number must consist of 8-15 digits." id="phone" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="628xxxxxxxx" required>
							<button type="submit" class="p-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m4.497 20.835l16.51-7.363c1.324-.59 1.324-2.354 0-2.944L4.497 3.164c-1.495-.667-3.047.814-2.306 2.202l3.152 5.904c.245.459.245 1 0 1.458l-3.152 5.904c-.74 1.388.81 2.87 2.306 2.202"/></svg>
							</button>
							<a href="/dashboard/devices" class="p-2 rounded-md bg-amber-500 dark:bg-amber-600 text-white hover:bg-amber-600 dark:hover:bg-amber-500 hover:duration-300 transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16.755 2h-9.51c-1.159 0-1.738 0-2.206.163a3.05 3.05 0 0 0-1.881 1.936C3 4.581 3 5.177 3 6.37v14.004c0 .858.985 1.314 1.608.744a.946.946 0 0 1 1.284 0l.483.442a1.657 1.657 0 0 0 2.25 0a1.657 1.657 0 0 1 2.25 0a1.657 1.657 0 0 0 2.25 0a1.657 1.657 0 0 1 2.25 0a1.657 1.657 0 0 0 2.25 0l.483-.442a.946.946 0 0 1 1.284 0c.623.57 1.608.114 1.608-.744V6.37c0-1.193 0-1.79-.158-2.27a3.05 3.05 0 0 0-1.881-1.937C18.493 2 17.914 2 16.755 2Z"/><path stroke-linecap="round" d="M10.5 11H17M7 11h.5M7 7.5h.5m-.5 7h.5m3-7H17m-6.5 7H17"/></g></svg>
							</a>
						</form>
						<p class="text-xs italic mt-1 ml-1 text-rose-500">
							The phone number must consist of 8-15 digits.
						<p>
						<p class="text-xs italic mt-1 ml-1 text-gray-500 dark:text-gray-400">
							<span class="font-semibold">NOTE</span>: Once created, a QR code will appear to log into WhatsApp.
						</p>
					</div>
					<div class="flex flex-col items-center">
					<% if (!phone) { %>
						<div class="flex flex-col gap-4 items-center">
							<h2 class="text-lg font-bold text-center">
								Scan to Connect
							</h2>
							<img class="border-2 border-dashed boder:gray-300 dark:border-slate-600 h-48 w-48 rounded-md object-cover" src="/assets/images/scan.gif" alt="qr" />
						</div>
						<% } else { %>
						<div class="flex flex-col gap-4 items-center justify-center">
							<h2 class="text-lg font-bold text-center">
								Scan to Connect
							</h2>
							<div id="qr"></div>
							<div>
								<p class="text-xs text-center text-amber-500">
									Connecting to <span class="font-semibold"><%= phone %></span>
								</p>
								<% if (error) { %>
									<p class="text-xs text-center text-rose-500">
										<%= error %>
									</p>
								<% } %>
							</div>
						</div>
					</div>
				</div>
			</div>
		<section>
	</main>
	
	<%- include('../components/error-log') %>
	
    <script>
      const wsProtocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
	  const ws = new WebSocket(`${wsProtocol}${location.host}/?phone=<%= phone %>`);
      ws.onmessage = (event) => {
        const data = JSON.parse(event.data);
        if (data.qr) {
          document.getElementById('qr').innerHTML = '<img class="mx-auto h-48 w-48 border-2 border-dashed boder:gray-300 dark:border-slate-600" src="'+data.qr+'" alt="QR Code" />';
        }
        if (data.connected) {
          document.getElementById('qr').innerHTML = '<div class="border-2 border-dashed boder:gray-300 dark:border-slate-600 text-emerald-500 font-bold h-48 w-48 flex flex-col items-center justify-center rounded-md p-2">Connected!</div>';
        }
        if (data.loggedOut) {
          document.getElementById('qr').innerHTML = '<div class="border-2 border-dashed boder:gray-300 dark:border-slate-600 text-rose-500 font-bold h-48 w-48 flex flex-col items-center justify-center rounded-md p-2">Logged Out!</div>';
        }
      };
    </script>
  <% } %>
  
	<script src="/assets/js/dashboard.js"></script>
	<script>
	  document.getElementById('phone').addEventListener('input', function (e) {
		this.value = this.value.replace(/\D/g, '');
	  });
	</script>
</body>
</html>
