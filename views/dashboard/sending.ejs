										<%= __('sending.Send') %> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m4.497 20.835l16.51-7.363c1.324-.59 1.324-2.354 0-2.944L4.497 3.164c-1.495-.667-3.047.814-2.306 2.202l3.152 5.904c.245.459.245 1 0 1.458l-3.152 5.904c-.74 1.388.81 2.87 2.306 2.202"></path></svg>
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		<section>
	</main>
  
	<div id="contact-modal" class="hidden fixed inset-0 flex items-center justify-center z-50">
	  <div class="relative bg-white w-full h-full dark:bg-slate-800 shadow-lg relative">
		<div class="w-full z-50 shadow absolute bg-white dark:bg-slate-900 top-0 left-0 flex items-center justify-between gap-4 px-4 py-2">
		  <form id="contact-search-form" class="flex items-center gap-2">
			<input type="text" name="search" id="search" value="" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="Search Contacts...">
			<button type="submit" title="Search" class="flex items-center gap-2 font-semibold p-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
			  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			  </svg>
			</button>
		  </form>
		  <button id="close-contact-modal" class="text-rose-500 dark:text-rose-600 hover:text-rose-600 hoer:dark:text-rose-500">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
			  <path fill="currentColor" fill-rule="evenodd" d="M12 22c-4.714 0-7.071 0-8.536-1.465C2 19.072 2 16.714 2 12s0-7.071 1.464-8.536C4.93 2 7.286 2 12 2s7.071 0 8.535 1.464C22 4.93 22 7.286 22 12s0 7.071-1.465 8.535C19.072 22 16.714 22 12 22M8.97 8.97a.75.75 0 0 1 1.06 0L12 10.94l1.97-1.97a.75.75 0 0 1 1.06 1.06L13.06 12l1.97 1.97a.75.75 0 1 1-1.06 1.06L12 13.06l-1.97 1.97a.75.75 0 1 1-1.06-1.06L10.94 12l-1.97-1.97a.75.75 0 0 1 0-1.06" clip-rule="evenodd"/>
			</svg>
		  </button>
		</div>
		<div id="contact-list" class="pt-20 max-h-full px-6 pb-6 overflow-y-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
		  <% if (contacts.length === 0) { %>
		    <p>No contact found.</p>
		  <% } else { %>
		  <% contacts.forEach(contact => { %>
			<button type="button" class="bg-slate-50 hover:bg-slate-100 dark:bg-slate-900 dark:hover:bg-slate-950 w-full min-w-[200px] flex flex-col text-left px-4 py-2 border border-gray-100 dark:border-slate-700 rounded" data-phone="<%= contact.phone %>" data-name="<%= contact.name.toLowerCase() %>">
			  <span class="font-semibold text-xl overflow-hidden line-clamp-1"><%= contact.name %></span>
			  <span class="overflow-hidden line-clamp-1"><%= contact.phone %></span>
			</button>
		  <% }) %>
		  <% } %>
		</div>
	  </div>
	</div>
	
	<div class="upload-modal hidden fixed inset-0 flex items-center justify-center z-50">
	  <div class="relative bg-white w-full h-full dark:bg-slate-800 shadow-lg">
		<div class="w-full z-50 shadow absolute bg-white dark:bg-slate-900 top-0 left-0 flex items-center justify-between gap-4 px-4 py-2">
		  <form class="upload-search-form flex items-center gap-2">
			<input type="text" name="upload-search" class="upload-search-input w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="Search Uploads...">
			<button type="submit" title="Search" class="flex items-center gap-2 font-semibold p-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
			  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			  </svg>
			</button>
		  </form>
		  <button class="close-upload-modal text-rose-500 dark:text-rose-600 hover:text-rose-600 hoer:dark:text-rose-500">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
			  <path fill="currentColor" fill-rule="evenodd" d="M12 22c-4.714 0-7.071 0-8.536-1.465C2 19.072 2 16.714 2 12s0-7.071 1.464-8.536C4.93 2 7.286 2 12 2s7.071 0 8.535 1.464C22 4.93 22 7.286 22 12s0 7.071-1.465 8.535C19.072 22 16.714 22 12 22M8.97 8.97a.75.75 0 0 1 1.06 0L12 10.94l1.97-1.97a.75.75 0 0 1 1.06 1.06L13.06 12l1.97 1.97a.75.75 0 1 1-1.06 1.06L12 13.06l-1.97 1.97a.75.75 0 1 1-1.06-1.06L10.94 12l-1.97-1.97a.75.75 0 0 1 0-1.06" clip-rule="evenodd"/>
			</svg>
		  </button>
		</div>
		<div class="upload-list pt-20 max-h-full px-6 pb-6 overflow-y-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
		  <% uploads.forEach(upload => { %>
			<button title="<%= upload.name %>" type="button" class="upload-item bg-slate-50 hover:bg-slate-100 dark:bg-slate-900 dark:hover:bg-slate-950 w-full min-w-[200px] flex flex-col text-left px-4 py-2 border border-gray-100 dark:border-slate-700 rounded" data-url="<%= baseUrl %><%= upload.path %>" data-name="<%= upload.name.toLowerCase() %>">
			  <span class="font-semibold text-xl overflow-hidden line-clamp-1"><%= upload.name %></span>
			  <span class="text-sm text-gray-600 dark:text-gray-400 overflow-hidden line-clamp-1"><%= baseUrl %><%= upload.path %></span>
			</button>
		  <% }) %>
		</div>
	  </div>
	</div>
	
	<%- include('../components/error-log') %>

	<script src="/assets/js/dashboard.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const typeSelect = document.getElementById('typeSelect');
			const formItems = document.querySelectorAll('#formContainer .form-item');

			function showSelectedForm(value) {
				formItems.forEach(form => {
					form.classList.add('hidden');
				});

				const selectedForm = document.getElementById(`form-${value}`);
				if (selectedForm) {
					selectedForm.classList.remove('hidden');
				}
			}

			showSelectedForm(typeSelect.value);

			typeSelect.addEventListener('change', function () {
				showSelectedForm(this.value);
			});
		});
	</script>
	<script>
		const modal = document.getElementById('contact-modal');
		const closeModalBtn = document.getElementById('close-contact-modal');
		const contactList = document.getElementById('contact-list');
		const searchInput = document.getElementById('search');

		let currentPhoneInput = null;

		document.querySelectorAll('.open-contact-modal-btn').forEach(button => {
		  button.addEventListener('click', (e) => {
			const parent = e.target.closest('div');
			currentPhoneInput = parent.querySelector('.phone-input');
			modal.classList.remove('hidden');
			searchInput.value = '';
			filterContacts('');
		  });
		});

		closeModalBtn.addEventListener('click', () => {
		  modal.classList.add('hidden');
		});

		modal.addEventListener('click', (e) => {
		  if (e.target === modal) {
			modal.classList.add('hidden');
		  }
		});

		contactList.addEventListener('click', (e) => {
		  const btn = e.target.closest('button[data-phone]');
		  if (!btn) return;

		  if (currentPhoneInput) {
			currentPhoneInput.value = btn.getAttribute('data-phone');
		  }
		  modal.classList.add('hidden');
		});

		searchInput.addEventListener('input', () => {
		  const query = searchInput.value.toLowerCase();
		  filterContacts(query);
		});

		function filterContacts(query) {
		  const contactButtons = contactList.querySelectorAll('button[data-name]');
		  contactButtons.forEach(btn => {
			const name = btn.getAttribute('data-name');
			if (name.includes(query)) {
			  btn.classList.remove('hidden');
			} else {
			  btn.classList.add('hidden');
			}
		  });
		}
	</script>
	<script>
		const uploadModal = document.querySelector('.upload-modal');
		  const closeUploadModalBtn = uploadModal.querySelector('.close-upload-modal');
		  const uploadList = uploadModal.querySelector('.upload-list');
		  const uploadSearchInput = uploadModal.querySelector('.upload-search-input');
		  let currentImageUrlInput = null;

		  document.querySelectorAll('.open-upload-modal-btn').forEach(button => {
			button.addEventListener('click', (e) => {
			  const parent = e.target.closest('div');
			  currentImageUrlInput = parent.querySelector('.uploads-url-input');
			  uploadModal.classList.remove('hidden');
			  uploadSearchInput.value = '';
			  filterUploads('');
			  uploadSearchInput.focus();
			});
		  });

		  closeUploadModalBtn.addEventListener('click', () => {
			uploadModal.classList.add('hidden');
		  });

		  uploadModal.addEventListener('click', (e) => {
			if (e.target === uploadModal) {
			  uploadModal.classList.add('hidden');
			}
		  });

		uploadList.addEventListener('click', (e) => {
		  const btn = e.target.closest('button.upload-item');
		  if (!btn) return;
		  if (currentImageUrlInput) {
			currentImageUrlInput.value = btn.getAttribute('data-url');
		  }
		  uploadModal.classList.add('hidden');
		});

		uploadSearchInput.addEventListener('input', () => {
		  const query = uploadSearchInput.value.toLowerCase();
		  filterUploads(query);
		});

		function filterUploads(query) {
		  const uploadButtons = uploadList.querySelectorAll('button.upload-item');
		  uploadButtons.forEach(btn => {
		    const name = btn.getAttribute('data-name');
		    if (name.includes(query)) {
			  btn.classList.remove('hidden');
		    } else {
		      btn.classList.add('hidden');
		    }
		  });
		}

		document.querySelector('#contact-search-form').addEventListener('submit', e => e.preventDefault());
		document.querySelector('.upload-search-form').addEventListener('submit', e => e.preventDefault());
	</script>
	<script>
	  const tabs = document.querySelectorAll('[data-tab]');
	  const contents = document.querySelectorAll('[data-content]');

	  function activateTab(target) {
		tabs.forEach(t => {
		  t.classList.remove('text-sky-500', 'bg-sky-500', 'dark:bg-sky-600', 'text-white', 'font-semibold');
		  t.classList.add('text-normal', 'bg-white', 'dark:bg-slate-800', 'border-t', 'border-l', 'border-r', 'border-gray-100', 'dark:border-slate-700');
		});
		contents.forEach(c => {
		  c.classList.add('hidden');
		  c.classList.remove('block');
		});

		const activeTab = document.querySelector(`[data-tab="${target}"]`);
		const activeContent = document.querySelector(`[data-content="${target}"]`);

		activeTab.classList.add('text-sky-500', 'bg-sky-500', 'dark:bg-sky-600', 'text-white', 'font-semibold');
		activeTab.classList.remove('text-normal', 'bg-white', 'dark:bg-slate-800', 'border-t', 'border-l', 'border-r', 'border-gray-100', 'dark:border-slate-700');

		activeContent.classList.remove('hidden');
		activeContent.classList.add('block');
	  }

	  window.addEventListener('DOMContentLoaded', () => {
		activateTab('1');
	  });

	  tabs.forEach(tab => {
		tab.addEventListener('click', () => {
		  const target = tab.getAttribute('data-tab');
		  activateTab(target);
		});
	  });
	</script>

</body>
</html>
