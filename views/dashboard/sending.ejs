<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: __('sending.Sending') + ' | ' + __('app.FhytsBot') }) %>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: __('sending.Sending') }) %>
		<section class="flex flex-col px-4 pb-4">
			<div class="flex gap-2 ml-3 h-10">
				<button data-tab="1" class="w-[150px] h-full px-4 rounded-t-md hover:bg-sky-500 dark:hover:bg-sky-600 hover:text-white dark:hover:text-white hover:text-semibold">
					<%= __('sending.History') %>
				</button>
				<button data-tab="2" class="w-[150px] h-full px-4 rounded-t-md hover:bg-sky-500 dark:hover:bg-sky-600 hover:text-white dark:hover:text-white hover:text-semibold">
					<%= __('sending.Sending') %>
				</button>
			</div>
			
			<div data-content="1" class="border-t-2 bg-white dark:bg-slate-800 p-4 md:p-6 rounded-md border-sky-500 dark:border-sky-600 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<div class="mb-4 flex items-center justify-between gap-4">
					<form class="flex items-center gap-2" method="GET">
						<input type="text" name="search" id="search" value="<%= search %>" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="<%= __('sending.Search') %>...">
						<button type="submit" title="Search" class="flex items-center gap-2 font-semibold p-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
							</svg>
						</button>
					</form>
				</div>
				<div class="prose prose-lg dark:prose-invert max-w-none">
				  <div class="overflow-auto w-full">
					<table class="min-w-full">
					  <thead>
						<tr>
						  <th><%= __('sending.Session') %></th>
						  <th><%= __('sending.To') %></th>
						  <th><%= __('sending.Content') %></th>
						  <th><%= __('sending.Type') %></th>
						  <th><%= __('sending.File') %></th>
						  <th><%= __('sending.Date') %></th>
						  <th><%= __('sending.Action') %></th>
						</tr>
					  </thead>
					  <tbody>
						<% if (messages.length === 0) { %>
						  <tr>
							<td colspan="7" class="text-center"><%= __('sending.No history found') %></td>
						  </tr>
						<% } else { %>
						  <% messages.forEach(message => { %>
							<tr>
							  <td>
								<%= message.session %>
							  </td>
							  <td>
								<%= message.phone %>
							  </td>
							  <td class="w-full">
								<% if (message.type === 'text' || message.type === 'document' || message.type === 'image' || message.type === 'video') { %>
								  <div class="overflow-hidden line-clamp-1"><%= message.content %></div>
								<% } else if (message.type === 'location') { %>
								  <span class="whitespace-nowrap"><%= message.location_name %> (<%= message.latitude %>, <%= message.longitude %>)</span>
								<% } else { %>
								  <span class="whitespace-nowrap text-rose-500"><%= __('sending.Not available') %></span>
								<% } %>
							  </td>
							  <td>
								<%= message.type.charAt(0).toUpperCase() + message.type.slice(1) %>
							  </td>
							  <td>
							    <% if (['image', 'video', 'audio', 'document', 'sticker'].includes(message.type) && message.media_url) { %>
							      <a href="<%= message.media_url %>" target="_blank" rel="noopener noreferrer" class="whitespace-nowrap">
							        <%= message.file_name || 'View Media' %>
							      </a>
							    <% } else { %>
							       <span class="whitespace-nowrap text-rose-500"><%= __('sending.Not available') %></span>
								<% } %>
							  </td>
							  <td class="whitespace-nowrap">
								<%
								  const createdAt = new Date(message.created_at);
								  const pad = (n) => n.toString().padStart(2, '0');
								  const formattedDate = `${pad(createdAt.getHours())}:${pad(createdAt.getMinutes())}:${pad(createdAt.getSeconds())} ${pad(createdAt.getDate())}/${pad(createdAt.getMonth() + 1)}/${createdAt.getFullYear()}`;
								  %>
								<%= formattedDate %>
							  </td>
							  <td class="text-center">
								<div class="flex items-center justify-center gap-2">
								  <form action="/dashboard/sending/delete/<%= message.id %>" method="POST" class="-mb-1">
									<button type="submit" class="text-rose-500" title="Delete">
									  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M2.75 6.167c0-.46.345-.834.771-.834h2.665c.529-.015.996-.378 1.176-.916l.03-.095l.115-.372c.07-.228.131-.427.217-.605c.338-.702.964-1.189 1.687-1.314c.184-.031.377-.031.6-.031h3.478c.223 0 .417 0 .6.031c.723.125 1.35.612 1.687 1.314c.086.178.147.377.217.605l.115.372l.03.095c.18.538.74.902 1.27.916h2.57c.427 0 .772.373.772.834S20.405 7 19.979 7H3.52c-.426 0-.771-.373-.771-.833M11.607 22h.787c2.707 0 4.06 0 4.941-.863c.88-.864.97-2.28 1.15-5.111l.26-4.081c.098-1.537.147-2.305-.295-2.792s-1.187-.487-2.679-.487H8.23c-1.491 0-2.237 0-2.679.487s-.392 1.255-.295 2.792l.26 4.08c.18 2.833.27 4.248 1.15 5.112S8.9 22 11.607 22"/></svg>
									</button>
								  </form>
								</div>
							  </td>
							</tr>
						  <% }) %>
						<% } %>
					  </tbody>
					</table>
				  </div>
				</div>
				<div class="flex items-center gap-2 justify-center mt-6">
				  <% if (totalPages > 1) { %>
					<% if (currentPage > 1) { %>
					  <a href="?search=<%= search %>&page=1" class="h-7 w-7 flex items-center justify-center p-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white rounded" title="First">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m13 19l-6-7l6-7"/><path d="m17 19l-6-7l6-7"/></g></svg>
					  </a>
					<% } %>

					<% for (let i = 1; i <= totalPages; i++) { %>
					  <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
						<a href="?search=<%= search %>&page=<%= i %>" class="h-7 w-7 flex items-center justify-center p-1 rounded 
						  <%= i === currentPage ? 'bg-sky-500 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white' %>">
						  <%= i %>
						</a>
					  <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
						<span class="h-7 w-4 flex items-center justify-center p-1">...</span>
					  <% } %>
					<% } %>

					<% if (currentPage < totalPages) { %>
					  <a href="?search=<%= search %>&page=<%= totalPages %>" class="h-7 w-7 flex items-center justify-center p-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white rounded">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m11 19l6-7l-6-7"/><path d="m7 19l6-7l-6-7"/></g></svg>
					  </a>
					<% } %>
				  <% } %>
				</div>
			</div>
			<div data-content="2" class="border-t-2 bg-white dark:bg-slate-800 p-4 md:p-6 rounded-md border-sky-500 dark:border-sky-600 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<div class="mb-4 flex items-center justify-between gap-4">
					<div class="w-full flex flex-col">
						<label class="block mb-2"><%= __('sending.Type') %></label>
						<select id="typeSelect" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
							<option value="text"><%= __('sending.Text') %></option>
							<option value="image"><%= __('sending.Image') %></option>
							<option value="video"><%= __('sending.Video') %></option>
							<option value="audio"><%= __('sending.Audio') %></option>
							<option value="document"><%= __('sending.Document') %></option>
							<option value="location"><%= __('sending.Location') %></option>
							<option value="sticker"><%= __('sending.Sticker') %></option>
						</select>
					</div>
				</div>
				<div id="formContainer" class="mt-9">
					<!-- Form Text -->
					<div id="form-text" class="form-item">
						<h2 class="text-xl font-bold">
							<%= __('sending.Text Message') %>
						</h2>
						<div class="mt-4">
							<form method="POST" action="/dashboard/sending/text-message" class="flex flex-col gap-4">
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.Session') %></label>
									<select id="session" name="session" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
									  <% if (devices.length > 0) { %>
										<% devices.forEach(device => { %>
										  <option value="<%= device.phone %>"><%= device.phone %></option>
										<% }) %>
									  <% } else { %>
										<option disabled selected><%= __('sending.No sessions available') %></option>
									  <% } %>
									</select>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.To') %></label>
									<div class="flex items-center gap-2 max-w-xs">
										<input type="text" name="phone" class="phone-input w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="628xxxxxxxx" required>
										<button type="button" class="open-contact-modal-btn text-sky-500 hover:text-sky-600 dark:text-sky-600 dark:hover:text-sky-500 hover:duration-300 transition-all" >
											<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M8.75 2.013V22H15c2.828 0 4.243 0 5.121-.879C21 20.243 21 18.828 21 16V8c0-2.828 0-4.243-.879-5.121C19.243 2 17.828 2 15 2H9zm2 4.487a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75m0 3.5a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75M3 7.25c.008-2.336.081-3.574.879-4.371c.675-.675 1.666-.832 3.371-.868v19.978c-1.705-.036-2.696-.193-3.371-.868c-.798-.797-.871-2.035-.878-4.371H4a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5zm0 0H2a.75.75 0 0 0 0 1.5h1zm0 5.5H2a.75.75 0 0 1 0-1.5h1zm0 2.5H2a.75.75 0 0 0 0 1.5h1z" clip-rule="evenodd"/></svg>
										</button>
									</div>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.Content') %></label>
									<textarea rows="4" name="content" class="w-full max-w-2xl bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" required></textarea>
								</div>
								<div>
									<button type="submit" class="flex items-center gap-2 font-semibold px-4 py-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
										<%= __('sending.Send') %> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m4.497 20.835l16.51-7.363c1.324-.59 1.324-2.354 0-2.944L4.497 3.164c-1.495-.667-3.047.814-2.306 2.202l3.152 5.904c.245.459.245 1 0 1.458l-3.152 5.904c-.74 1.388.81 2.87 2.306 2.202"></path></svg>
									</button>
								</div>
							</form>
						</div>
					</div>

					<!-- Form Image -->
					<div id="form-image" class="form-item hidden">
						<h2 class="text-xl font-bold">
							<%= __('sending.Image Message') %>
						</h2>
						<div class="mt-4">
							<form method="POST" action="/dashboard/sending/image-message" class="flex flex-col gap-4">
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sendingSession') %></label>
									<select id="session" name="session" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
									  <% if (devices.length > 0) { %>
										<% devices.forEach(device => { %>
										  <option value="<%= device.phone %>"><%= device.phone %></option>
										<% }) %>
									  <% } else { %>
										<option disabled selected><%= __('sending.No sessions available') %></option>
									  <% } %>
									</select>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.To') %></label>
									<div class="flex items-center gap-2 max-w-xs">
										<input type="text" name="phone" class="phone-input w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="628xxxxxxxx" required>
										<button type="button" class="open-contact-modal-btn text-sky-500 hover:text-sky-600 dark:text-sky-600 dark:hover:text-sky-500 hover:duration-300 transition-all" >
											<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M8.75 2.013V22H15c2.828 0 4.243 0 5.121-.879C21 20.243 21 18.828 21 16V8c0-2.828 0-4.243-.879-5.121C19.243 2 17.828 2 15 2H9zm2 4.487a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75m0 3.5a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75M3 7.25c.008-2.336.081-3.574.879-4.371c.675-.675 1.666-.832 3.371-.868v19.978c-1.705-.036-2.696-.193-3.371-.868c-.798-.797-.871-2.035-.878-4.371H4a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5zm0 0H2a.75.75 0 0 0 0 1.5h1zm0 5.5H2a.75.75 0 0 1 0-1.5h1zm0 2.5H2a.75.75 0 0 0 0 1.5h1z" clip-rule="evenodd"/></svg>
										</button>
									</div>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.File URL') %></label>
									<div class="flex items-center gap-2 max-w-2xl">
										<input type="text" name="image-url" class="uploads-url-input w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="https://example.com/image.png" required>
										<button type="button" class="open-upload-modal-btn text-sky-500 hover:text-sky-600 dark:text-sky-600 dark:hover:text-sky-500 hover:duration-300 transition-all">
											<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M2.07 5.258C2 5.626 2 6.068 2 6.95V14c0 3.771 0 5.657 1.172 6.828S6.229 22 10 22h4c3.771 0 5.657 0 6.828-1.172S22 17.771 22 14v-2.202c0-2.632 0-3.949-.77-4.804a3 3 0 0 0-.224-.225C20.151 6 18.834 6 16.202 6h-.374c-1.153 0-1.73 0-2.268-.153a4 4 0 0 1-.848-.352C12.224 5.224 11.816 4.815 11 4l-.55-.55c-.274-.274-.41-.41-.554-.53a4 4 0 0 0-2.18-.903C7.53 2 7.336 2 6.95 2c-.883 0-1.324 0-1.692.07A4 4 0 0 0 2.07 5.257M12.25 10a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75" clip-rule="evenodd"/></svg>
										</button>
									</div>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.Caption') %></label>
									<textarea rows="4" name="caption" class="w-full max-w-2xl bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" required></textarea>
								</div>
								<div>
									<button type="submit" class="flex items-center gap-2 font-semibold px-4 py-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
										<%= __('sending.Send') %> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="m4.497 20.835l16.51-7.363c1.324-.59 1.324-2.354 0-2.944L4.497 3.164c-1.495-.667-3.047.814-2.306 2.202l3.152 5.904c.245.459.245 1 0 1.458l-3.152 5.904c-.74 1.388.81 2.87 2.306 2.202"></path></svg>
									</button>
								</div>
							</form>
						</div>
					</div>

					<!-- Form Video -->
					<div id="form-video" class="form-item hidden">
						<h2 class="text-xl font-bold">
							<%= __('sending.Video Message') %>
						</h2>
						<div class="mt-4">
							<form method="POST" action="/dashboard/sending/video-message" class="flex flex-col gap-4">
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.Session') %></label>
									<select id="session" name="session" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
									  <% if (devices.length > 0) { %>
										<% devices.forEach(device => { %>
										  <option value="<%= device.phone %>"><%= device.phone %></option>
										<% }) %>
									  <% } else { %>
										<option disabled selected><%= __('sending.No sessions available') %></option>
									  <% } %>
									</select>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.To') %></label>
									<div class="flex items-center gap-2 max-w-xs">
										<input type="text" name="phone" class="phone-input w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="628xxxxxxxx" required>
										<button type="button" class="open-contact-modal-btn text-sky-500 hover:text-sky-600 dark:text-sky-600 dark:hover:text-sky-500 hover:duration-300 transition-all" >
											<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M8.75 2.013V22H15c2.828 0 4.243 0 5.121-.879C21 20.243 21 18.828 21 16V8c0-2.828 0-4.243-.879-5.121C19.243 2 17.828 2 15 2H9zm2 4.487a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75m0 3.5a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75M3 7.25c.008-2.336.081-3.574.879-4.371c.675-.675 1.666-.832 3.371-.868v19.978c-1.705-.036-2.696-.193-3.371-.868c-.798-.797-.871-2.035-.878-4.371H4a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5H3v-2.5h1a.75.75 0 0 0 0-1.5zm0 0H2a.75.75 0 0 0 0 1.5h1zm0 5.5H2a.75.75 0 0 1 0-1.5h1zm0 2.5H2a.75.75 0 0 0 0 1.5h1z" clip-rule="evenodd"/></svg>
										</button>
									</div>
								</div>
								<div class="flex flex-col">
									<label class="block mb-2"><%= __('sending.File URL') %></label>
									<div class="flex items-center gap-2 max-w-2xl">
