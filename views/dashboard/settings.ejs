<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: __('settings.Setting') + ' | ' + __('app.FhytsBot') }) %>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: __('settings.Setting') }) %>
		<section class="px-4 pb-4">
			<div class="bg-white dark:bg-slate-800 p-4 md:p-6 border rounded-md border-gray-100 dark:border-slate-800 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<h1 class="text-xl font-bold text-black dark:text-white mb-6">
					<%= __('settings.General Information') %>
				</h1>
				<div class="mb-6 flex flex-col items-center md:items-start">
				  <h2 class="mb-1 flex gap-2 items-center">
					<%= user.package_name %>: 
					<span class="font-semibold">
						<% if (user.expiredFormatted === "Unlimited") { %>
						  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M7 7.75a4.25 4.25 0 0 0 0 8.5c.597 0 1.045-.107 1.407-.284c.362-.176.679-.442.986-.816c.54-.66.983-1.558 1.567-2.741q.175-.355.37-.744l.34-.69c.581-1.181 1.117-2.27 1.777-3.075c.41-.501.89-.923 1.49-1.215S16.216 6.25 17 6.25a5.75 5.75 0 1 1-3.45 10.35a.75.75 0 0 1 .9-1.2A4.25 4.25 0 1 0 17 7.75c-.597 0-1.045.107-1.407.284c-.362.176-.679.442-.986.816c-.54.66-.983 1.558-1.567 2.741q-.175.355-.37.744l-.34.69c-.581 1.181-1.117 2.27-1.777 3.076c-.41.5-.89.922-1.49 1.214s-1.28.435-2.063.435A5.75 5.75 0 1 1 10.451 7.4a.75.75 0 1 1-.901 1.2A4.23 4.23 0 0 0 7 7.75" clip-rule="evenodd"></path></svg>
						<% } else { %>
						  <%= user.expiredFormatted %>
						<% } %>
					</span>
					<a href="/#pricing" class="text-sky-500 font-semibold text-sm">
						<%= __('settings.Update Package') %>
					</a>
				  </h2>

				  <% if (
					(user.remainingDays !== null && user.totalDays !== null) ||
					user.expiredFormatted === 'Unlimited'
				  ) { %>
					<div class="flex w-full flex-col max-w-xs">
					  <div class="w-full bg-gray-200 dark:bg-slate-600 rounded-md h-6 overflow-hidden">
						<div
						  class="bg-green-500 h-full transition-all duration-300"
						  style="width: <%= user.expiredFormatted === 'Unlimited' ? '100' : user.progressPercent %>%;">
						</div>
					  </div>
					  <div class="w-full flex justify-between text-sm font-semibold">
						<% if (user.expiredFormatted === 'Unlimited') { %>
						  <span>Lifetime</span>
						  <span>100%</span>
						<% } else { %>
						  <span><%= user.usedDaysDisplay %> <%= __('settings.Days') %></span>
						  <span><%= user.progressPercent %>%</span>
						<% } %>
					  </div>
					</div>
				  <% } else { %>
					<p class="text-rose-500 font-semibold"><%= __('settings.No Active Packages') %></p>
				  <% } %>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<form action="/dashboard/settings/update" method="POST" class="flex flex-col gap-4">
						<div class="flex flex-col gap-1">
							<label for="name" class="font-medium"><%= __('settings.Full Name') %></label>
							<input id="name" type="text" name="name" value="<%= user.name %>" maxlength="25" pattern="^[a-zA-Z\s]+$" class="w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="Jhon Doe" required>
						</div>
						<div class="flex flex-col gap-1">
							<label for="email" class="font-medium"><%= __('settings.Email') %></label>
							<input id="email" type="email" value="<%= user.email %>" readonly class="w-full bg-gray-100 dark:bg-slate-950 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="your-mail@gmail.com" required>
						</div>
						<div class="flex flex-col gap-1">
							<label for="role" class="font-medium"><%= __('settings.Roles') %></label>
							<input id="text" type="text" value="<%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>" readonly class="w-full bg-gray-100 dark:bg-slate-950 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
						</div>
						<div class="flex flex-col gap-1">
							<label for="status" class="font-medium"><%= __('settings.Status') %></label>
							<input id="status" type="text" value="<%= user.status.charAt(0).toUpperCase() + user.status.slice(1) %>" readonly class="w-full bg-gray-100 dark:bg-slate-950 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none">
						</div>
						<div class="flex justify-end">
							<button class="flex items-center gap-2 px-4 py-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12.62 2.762A8 8 0 0 0 12 2.75c-2.378 0-4.086.002-5.386.176c-1.279.172-2.05.5-2.62 1.069c-.569.57-.896 1.34-1.068 2.619c-.174 1.3-.176 3.008-.176 5.386s.002 4.086.176 5.386c.172 1.279.5 2.05 1.069 2.62c.513.513 1.19.829 2.255 1.012v-.07c0-.899 0-1.648.08-2.242c.084-.628.27-1.195.725-1.65c.456-.456 1.023-.642 1.65-.726c.595-.08 1.345-.08 2.243-.08h2.104c.899 0 1.648 0 2.242.08c.628.084 1.195.27 1.65.726c.456.455.642 1.022.726 1.65c.08.594.08 1.343.08 2.242v.07c1.065-.183 1.742-.5 2.255-1.013c.57-.57.897-1.34 1.069-2.619c.174-1.3.176-3.008.176-5.386c0-.353 0-.487-.012-.62a3.3 3.3 0 0 0-.749-1.807a8 8 0 0 0-.439-.457L14.884 3.95a8 8 0 0 0-.457-.44a3.3 3.3 0 0 0-1.806-.748m3.63 18.418V21c0-.964-.002-1.612-.067-2.095c-.062-.461-.169-.659-.3-.789s-.327-.237-.788-.3c-.483-.064-1.131-.066-2.095-.066h-2c-.964 0-1.612.002-2.095.067c-.461.062-.659.169-.789.3s-.237.327-.3.788c-.064.483-.066 1.131-.066 2.095v.18c1.126.07 2.508.07 4.25.07s3.124 0 4.25-.07m-4.22-19.93c.312 0 .513 0 .72.018a4.8 4.8 0 0 1 2.64 1.094c.16.133.305.279.53.504l.024.023l5.19 5.19c.224.225.37.37.503.53a4.8 4.8 0 0 1 1.094 2.64c.018.207.018.408.018.72v.088c0 2.309 0 4.118-.19 5.53c-.194 1.444-.6 2.584-1.494 3.479c-.895.895-2.035 1.3-3.48 1.494c-1.411.19-3.22.19-5.529.19h-.114c-2.309 0-4.118 0-5.53-.19c-1.444-.194-2.584-.6-3.479-1.494c-.895-.895-1.3-2.035-1.494-3.48c-.19-1.411-.19-3.22-.19-5.529v-.114c0-2.309 0-4.118.19-5.53c.194-1.444.6-2.584 1.494-3.479c.895-.895 2.035-1.3 3.48-1.494c1.411-.19 3.22-.19 5.529-.19zM6.25 8A.75.75 0 0 1 7 7.25h6a.75.75 0 0 1 0 1.5H7A.75.75 0 0 1 6.25 8" clip-rule="evenodd"/></svg>
								<%= __('settings.Save') %>
							</button>
						</div>
					</form>
					<form action="/dashboard/settings/password" method="POST" class="flex flex-col gap-4">
						<div class="relative flex flex-col gap-1">
							<label for="password" class="font-medium"><%= __('settings.Password') %></label>
							<input id="password" type="password" name="password" class="w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="••••••••••••" required>
							<button type="button" class="absolute z-10 right-2 bottom-2" onclick="togglePassword('password', 'eyeIcon1')">
								<svg id="eyeIcon1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M9.75 12a2.25 2.25 0 1 1 4.5 0a2.25 2.25 0 0 1-4.5 0"/><path fill="currentColor" fill-rule="evenodd" d="M2 12c0 1.64.425 2.191 1.275 3.296C4.972 17.5 7.818 20 12 20s7.028-2.5 8.725-4.704C21.575 14.192 22 13.639 22 12c0-1.64-.425-2.191-1.275-3.296C19.028 6.5 16.182 4 12 4S4.972 6.5 3.275 8.704C2.425 9.81 2 10.361 2 12m10-3.75a3.75 3.75 0 1 0 0 7.5a3.75 3.75 0 0 0 0-7.5" clip-rule="evenodd"/></svg>
							</button>
						</div>
						<div class="relative flex flex-col gap-1">
							<label for="re-password" class="font-medium"><%= __('settings.Confirm Password') %></label>
							<input id="re-password" type="password" name="re-password" class="w-full bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="••••••••••••" required>
							<button type="button" class="absolute z-10 right-2 bottom-2" onclick="togglePassword('re-password', 'eyeIcon2')">
								<svg id="eyeIcon2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M9.75 12a2.25 2.25 0 1 1 4.5 0a2.25 2.25 0 0 1-4.5 0"/><path fill="currentColor" fill-rule="evenodd" d="M2 12c0 1.64.425 2.191 1.275 3.296C4.972 17.5 7.818 20 12 20s7.028-2.5 8.725-4.704C21.575 14.192 22 13.639 22 12c0-1.64-.425-2.191-1.275-3.296C19.028 6.5 16.182 4 12 4S4.972 6.5 3.275 8.704C2.425 9.81 2 10.361 2 12m10-3.75a3.75 3.75 0 1 0 0 7.5a3.75 3.75 0 0 0 0-7.5" clip-rule="evenodd"/></svg>
							</button>
						</div>
						<div class="flex justify-end">
							<button class="flex items-center gap-2 px-4 py-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12.62 2.762A8 8 0 0 0 12 2.75c-2.378 0-4.086.002-5.386.176c-1.279.172-2.05.5-2.62 1.069c-.569.57-.896 1.34-1.068 2.619c-.174 1.3-.176 3.008-.176 5.386s.002 4.086.176 5.386c.172 1.279.5 2.05 1.069 2.62c.513.513 1.19.829 2.255 1.012v-.07c0-.899 0-1.648.08-2.242c.084-.628.27-1.195.725-1.65c.456-.456 1.023-.642 1.65-.726c.595-.08 1.345-.08 2.243-.08h2.104c.899 0 1.648 0 2.242.08c.628.084 1.195.27 1.65.726c.456.455.642 1.022.726 1.65c.08.594.08 1.343.08 2.242v.07c1.065-.183 1.742-.5 2.255-1.013c.57-.57.897-1.34 1.069-2.619c.174-1.3.176-3.008.176-5.386c0-.353 0-.487-.012-.62a3.3 3.3 0 0 0-.749-1.807a8 8 0 0 0-.439-.457L14.884 3.95a8 8 0 0 0-.457-.44a3.3 3.3 0 0 0-1.806-.748m3.63 18.418V21c0-.964-.002-1.612-.067-2.095c-.062-.461-.169-.659-.3-.789s-.327-.237-.788-.3c-.483-.064-1.131-.066-2.095-.066h-2c-.964 0-1.612.002-2.095.067c-.461.062-.659.169-.789.3s-.237.327-.3.788c-.064.483-.066 1.131-.066 2.095v.18c1.126.07 2.508.07 4.25.07s3.124 0 4.25-.07m-4.22-19.93c.312 0 .513 0 .72.018a4.8 4.8 0 0 1 2.64 1.094c.16.133.305.279.53.504l.024.023l5.19 5.19c.224.225.37.37.503.53a4.8 4.8 0 0 1 1.094 2.64c.018.207.018.408.018.72v.088c0 2.309 0 4.118-.19 5.53c-.194 1.444-.6 2.584-1.494 3.479c-.895.895-2.035 1.3-3.48 1.494c-1.411.19-3.22.19-5.529.19h-.114c-2.309 0-4.118 0-5.53-.19c-1.444-.194-2.584-.6-3.479-1.494c-.895-.895-1.3-2.035-1.494-3.48c-.19-1.411-.19-3.22-.19-5.529v-.114c0-2.309 0-4.118.19-5.53c.194-1.444.6-2.584 1.494-3.479c.895-.895 2.035-1.3 3.48-1.494c1.411-.19 3.22-.19 5.529-.19zM6.25 8A.75.75 0 0 1 7 7.25h6a.75.75 0 0 1 0 1.5H7A.75.75 0 0 1 6.25 8" clip-rule="evenodd"/></svg>
								<%= __('settings.Change') %>
							</button>
						</div>
					</form>

				</div>
			</div>
		</section>
	</main>

	<%- include('../components/error-log') %>
	
	<script src="/assets/js/dashboard.js"></script>
	<script>
	  function togglePassword(inputId, iconId) {
		const input = document.getElementById(inputId);
		const icon = document.getElementById(iconId);

		const isHidden = input.type === "password";

		input.type = isHidden ? "text" : "password";

		icon.innerHTML = isHidden
		  ? `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M1.606 6.08a1 1 0 0 1 1.313.526L2 7l.92-.394v-.001l.003.009l.021.045l.094.194c.086.172.219.424.4.729a13.4 13.4 0 0 0 1.67 2.237a12 12 0 0 0 .59.592C7.18 11.8 9.251 13 12 13a8.7 8.7 0 0 0 3.22-.602c1.227-.483 2.254-1.21 3.096-1.998a13 13 0 0 0 2.733-3.725l.027-.058l.005-.011a1 1 0 0 1 1.838.788L22 7l.92.394l-.003.005l-.004.008l-.011.026l-.04.087a14 14 0 0 1-.741 1.348a15.4 15.4 0 0 1-1.711 2.256l.797.797a1 1 0 0 1-1.414 1.415l-.84-.84a12 12 0 0 1-1.897 1.256l.782 1.202a1 1 0 1 1-1.676 1.091l-.986-1.514c-.679.208-1.404.355-2.176.424V16.5a1 1 0 0 1-2 0v-1.544c-.775-.07-1.5-.217-2.177-.425l-.985 1.514a1 1 0 0 1-1.676-1.09l.782-1.203c-.7-.37-1.332-.8-1.897-1.257l-.84.84a1 1 0 0 1-1.414-1.414l.797-.797a15.4 15.4 0 0 1-1.87-2.519a14 14 0 0 1-.591-1.107l-.033-.072l-.01-.021l-.002-.007l-.001-.002v-.001C1.08 7.395 1.08 7.394 2 7l-.919.395a1 1 0 0 1 .525-1.314" clip-rule="evenodd"/></svg>`
		  : `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M9.75 12a2.25 2.25 0 1 1 4.5 0a2.25 2.25 0 0 1-4.5 0"/><path fill="currentColor" fill-rule="evenodd" d="M2 12c0 1.64.425 2.191 1.275 3.296C4.972 17.5 7.818 20 12 20s7.028-2.5 8.725-4.704C21.575 14.192 22 13.639 22 12c0-1.64-.425-2.191-1.275-3.296C19.028 6.5 16.182 4 12 4S4.972 6.5 3.275 8.704C2.425 9.81 2 10.361 2 12m10-3.75a3.75 3.75 0 1 0 0 7.5a3.75 3.75 0 0 0 0-7.5" clip-rule="evenodd"/></svg>`;
	  }
	</script>
</body>
</html>
