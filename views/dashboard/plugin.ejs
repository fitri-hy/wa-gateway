<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Plugin | FhytsBot' }) %>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="flex text-gray-700 dark:text-neutral-200 bg-gradient-to-r from-slate-50 to-white dark:from-slate-700 dark:to-slate-800 min-h-screen w-full">
	<aside id="sidebar" class="flex-none fixed md:static top-0 left-0 overflow-y-auto h-screen w-64 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50">
		<%- include('../components/sidebar-dash') %>
	</aside>

	<main class="flex flex-col gap-4 h-screen w-full overflow-y-auto">
		<%- include('../components/header-dash', { dash_title: 'Plugin' }) %>
		<section class="px-4 pb-4">
	
			<div class="flex gap-2 ml-3 h-10">
				<button id="tab-active" class="w-[100px] h-full px-4 rounded-t-md hover:bg-sky-500 dark:hover:bg-sky-600 hover:text-white dark:hover:text-white hover:text-semibold">
					Active
				</button>
				<button id="tab-inactive" class="w-[100px] h-full px-4 rounded-t-md hover:bg-sky-500 dark:hover:bg-sky-600 hover:text-white dark:hover:text-white hover:text-semibold">
					Inactive
				</button>
			</div>

			<div id="active-plugins" class="border-t-2 bg-white dark:bg-slate-800 p-4 md:p-6 rounded-md border-sky-500 dark:border-sky-600 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<% const activePlugins = plugins.filter(plugin => plugin.sessions.some(s => s.enabled));%>
					<% if (activePlugins.length === 0) { %>
						<p class="text-center py-6">There are no active plugins.</p>
					<% } else { %>
					<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mt-2">
						<% activePlugins.forEach(plugin => { %>
							<div class="flex flex-col gap-3 border p-3 rounded-md border-gray-100 dark:border-slate-700">
								<div class="flex flex-col gap-2">
									<h3 class="font-semibold overflow-hidden line-clamp-1">
										<%= plugin.title %>
									</h3>
									<div class="overflow-hidden line-clamp-2 text-xs min-h-[35px]">
										<%= plugin.description %>
									</div>
									<p class="overflow-hidden line-clamp-1 text-xs">
										Publish by <a href="<%= plugin.github %>" class="font-semibold text-sky-500" target="_blank"><%= plugin.author %></a>
									</p>
									<div class="h-[4rem] overflow-y-auto text-xs flex flex-col border border-gray-100 dark:border-slate-700/60 bg-gray-50 dark:bg-slate-900/30 rounded px-2 py-1">
										<span class="font-semibold">How to Use:</span>
										<span class="italic text-emerald-500">
											!<%= plugin.command %>
										</span>
									</div>
								</div>
								<div class="flex flex-col space-y-1 border-t border-gray-200 dark:border-slate-700 pt-3">
									<% if (plugin.sessions.length === 0) { %>
										<p class="text-center prose dark:prose-invert text-xs italic">
											<a href="/dashboard">Create a session</a> to activate the plugin.
										</p>
									<% } else { %>
									<% plugin.sessions.forEach(session => { %>
									<label class="flex justify-between gap-4 cursor-pointer mt-1">
										<span class="font-semibold select-none text-sm"><%= session.phone %></span>
										<input type="checkbox" class="plugin-toggle sr-only peer" data-plugin="<%= plugin.fileName %>" data-session="<%= session.sessionId %>" <% if (session.enabled) { %> checked <% } %>>
										<div class="relative w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-gray-600 peer-checked:bg-sky-600 dark:peer-checked:bg-sky-600"></div>
									</label>
									<% }) %>
									<% } %>
								</div>
							</div>
						<% }) %>
					</div>
				<% } %>
			</div>
		
			<div id="inactive-plugins" class="hidden border-t-2 bg-white dark:bg-slate-800 p-4 md:p-6 rounded-md border-sky-500 dark:border-sky-600 shadow-md shadow-gray-100 dark:shadow-slate-900">
				<div class="mb-4 flex items-center justify-between gap-4">
					<form class="flex items-center gap-2" method="GET">
						<input type="text" name="search" id="search" value="<%= search %>" class="w-full max-w-xs bg-gray-50 dark:bg-slate-900 px-4 py-2 rounded-md border border-gray-200 dark:border-slate-700 focus:outline-none" placeholder="Search...">
						<button type="submit" title="Search" class="flex items-center gap-2 font-semibold p-2 rounded-md bg-sky-500 dark:bg-sky-600 text-white hover:bg-sky-600 dark:hover:bg-sky-500 hover:duration-300 transition-all">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
								<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
							</svg>
						</button>
					</form>
				</div>
				<% const inactivePlugins = plugins.filter(plugin => !plugin.sessions.some(s => s.enabled)); %>
				<% if (inactivePlugins.length === 0) { %>
					<p class="text-center py-6">There are no active plugins.</p>
				<% } else { %>
				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mt-9">
					<% inactivePlugins.forEach(plugin => { %>
						<div class="flex flex-col gap-3 border p-3 rounded-md border-gray-100 dark:border-slate-700">
							<div class="flex flex-col gap-2">
								<h3 class="font-semibold overflow-hidden line-clamp-1">
									<%= plugin.title %>
								</h3>
								<div class="overflow-hidden line-clamp-2 text-xs min-h-[35px]">
									<%= plugin.description %>
								</div>
								<p class="overflow-hidden line-clamp-1 text-xs">
									Publish by <a href="<%= plugin.github %>" class="font-semibold text-sky-500" target="_blank"><%= plugin.author %></a>
								</p>
								<div class="h-[4rem] overflow-y-auto text-xs flex flex-col border border-gray-100 dark:border-slate-700/60 bg-gray-50 dark:bg-slate-900/30 rounded px-2 py-1">
									<span class="font-semibold">How to Use:</span>
									<span class="italic text-emerald-500">
										!<%= plugin.command %>
									</span>
								</div>
							</div>
							<div class="flex flex-col space-y-1 border-t border-gray-200 dark:border-slate-700 pt-3">
								<% if (plugin.sessions.length === 0) { %>
									<p class="text-center prose dark:prose-invert text-xs italic">
										<a href="/dashboard">Create a session</a> to activate the plugin.
									</p>
								<% } else { %>
								<% plugin.sessions.forEach(session => { %>
								<label class="flex justify-between gap-4 cursor-pointer mt-1">
									<span class="font-semibold select-none text-sm"><%= session.phone %></span>
									<input type="checkbox" class="plugin-toggle sr-only peer" data-plugin="<%= plugin.fileName %>" data-session="<%= session.sessionId %>" <% if (session.enabled) { %> checked <% } %>>
									<div class="relative w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-gray-600 peer-checked:bg-sky-600 dark:peer-checked:bg-sky-600"></div>
								</label>
								<% }) %>
								<% } %>
							</div>
						</div>
					<% }) %>
					<% } %>
				</div>
				<div class="flex items-center gap-2 justify-center mt-6">
				  <% if (totalPages > 1) { %>
					<% if (currentPage > 1) { %>
					  <a href="?search=<%= search %>&page=1#inactive" class="h-7 w-7 flex items-center justify-center p-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white rounded" title="First">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m13 19l-6-7l6-7"/><path d="m17 19l-6-7l6-7"/></g></svg>
					  </a>
					<% } %>

					<% for (let i = 1; i <= totalPages; i++) { %>
					  <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
						<a href="?search=<%= search %>&page=<%= i %>#inactive" class="h-7 w-7 flex items-center justify-center p-1 rounded 
						  <%= i === currentPage ? 'bg-sky-500 text-white' : 'bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white' %>">
						  <%= i %>
						</a>
					  <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
						<span class="h-7 w-4 flex items-center justify-center p-1">...</span>
					  <% } %>
					<% } %>

					<% if (currentPage < totalPages) { %>
					  <a href="?search=<%= search %>&page=<%= totalPages %>#inactive" class="h-7 w-7 flex items-center justify-center p-1 bg-slate-100 dark:bg-slate-700 hover:bg-sky-500 hover:text-white rounded">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m11 19l6-7l-6-7"/><path d="m7 19l6-7l-6-7"/></g></svg>
					  </a>
					<% } %>
				  <% } %>
				</div>
			</div>
		<section>
	</main>
  
	<script src="/assets/js/dashboard.js"></script>
	<script>
	  const tabActiveBtn = document.getElementById('tab-active');
	  const tabInactiveBtn = document.getElementById('tab-inactive');
	  const activeDiv = document.getElementById('active-plugins');
	  const inactiveDiv = document.getElementById('inactive-plugins');

	  function setTabActive(activeBtn, inactiveBtn, showDiv, hideDiv) {
		showDiv.style.display = 'block';
		hideDiv.style.display = 'none';

		activeBtn.classList.add('text-white', 'bg-sky-500', 'dark:bg-sky-600', 'font-semibold');
		activeBtn.classList.remove('bg-white', 'text-gray-800', 'dark:bg-slate-800', 'border', 'border-gray-100', 'dark:border-slate-700');

		inactiveBtn.classList.remove('text-white', 'bg-sky-500', 'dark:bg-sky-600', 'font-semibold');
		inactiveBtn.classList.add('bg-white', 'text-gray-800', 'dark:bg-slate-800', 'border', 'border-gray-100', 'dark:border-slate-700');
	  }

	  function activateTabFromHash() {
		const hash = window.location.hash;

		if (hash === '#inactive') {
		  setTabActive(tabInactiveBtn, tabActiveBtn, inactiveDiv, activeDiv);
		} else {
		  setTabActive(tabActiveBtn, tabInactiveBtn, activeDiv, inactiveDiv);
		}
	  }

	  window.addEventListener('DOMContentLoaded', activateTabFromHash);
	  window.addEventListener('hashchange', activateTabFromHash);

	  tabActiveBtn.addEventListener('click', () => {
		window.location.hash = 'active';
	  });

	  tabInactiveBtn.addEventListener('click', () => {
		window.location.hash = 'inactive';
	  });
	</script>
	<script>
	  document.querySelectorAll('.plugin-toggle').forEach(toggle => {
		toggle.addEventListener('change', async function () {
		  const pluginName = this.dataset.plugin;
		  const sessionId = this.dataset.session;
		  const enable = this.checked;

		  try {
			const response = await fetch('/dashboard/plugin/enable', {
			  method: 'POST',
			  headers: { 'Content-Type': 'application/json' },
			  body: JSON.stringify({ pluginName, sessionId, enable }),
			});

			const data = await response.json();

			if (!data.success) {
			  alert('Gagal update plugin: ' + (data.error || 'Unknown error'));
			  this.checked = !enable;
			} else {
			  setTimeout(() => {
                window.location.href = '/dashboard/plugin';
              }, 200);
			}
		  } catch (e) {
			alert('Error saat update plugin');
			this.checked = !enable;
		  }
		});
	  });
	</script>
</body>
</html>
